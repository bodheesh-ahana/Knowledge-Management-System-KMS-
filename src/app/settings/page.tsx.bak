pan>\n                Recent Entries\n            </a>\n</div>\n</aside>\n<!-- Main Content Canvas -->\n<main class=\"md:ml-sidebar-width min-h-[calc(100vh-56px)] p-lg lg:p-xl bg-background dark:bg-background\">\n<div class=\"max-w-container-max mx-auto\">\n<!-- Header -->\n<div class=\"mb-xl\">\n<h2 class=\"font-h1 text-h1 text-on-background dark:text-on-surface mb-xs\">Settings</h2>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant dark:text-outline\">Manage your workspace preferences and account configurations.</p>\n</div>\n<!-- Settings Layout Grid -->\n<div class=\"flex flex-col md:flex-row gap-2xl relative items-start\">\n<!-- Settings Sub-Navigation -->\n<nav class=\"w-full md:w-64 shrink-0 flex flex-col gap-xs sticky top-24\">\n<a class=\"px-md py-sm rounded-md font-body-md text-body-md text-on-surface-variant dark:text-outline hover:bg-surface-container dark:hover:bg-surface-container-highest transition-colors\" href=\"#\">\n                        Profile\n                    </a>\n<!-- Active State for Sub-Nav -->\n<a class=\"px-md py-sm rounded-md font-body-md text-body-md bg-surface-container-high dark:bg-surface-container-highest text-on-surface dark:text-inverse-on-surface font-semibold flex items-center justify-between\" href=\"#\">\n                        Appearance\n                        <span class=\"material-symbols-outlined text-[16px]\">chevron_right</span>\n</a>\n<a class=\"px-md py-sm rounded-md font-body-md text-body-md text-on-surface-variant dark:text-outline hover:bg-surface-container dark:hover:bg-surface-container-highest transition-colors\" href=\"#\">\n                        Notifications\n                    </a>\n<a class=\"px-md py-sm rounded-md font-body-md text-body-md text-on-surface-variant dark:text-outline hover:bg-surface-container dark:hover:bg-surface-container-highest transition-colors\" href=\"#\">\n                        Keyboard Shortcuts\n                    </a>\n<a class=\"px-md py-sm rounded-md font-body-md text-body-md text-on-surface-variant dark:text-outline hover:bg-surface-container dark:hover:bg-surface-container-highest transition-colors\" href=\"#\">\n                        Security\n                    </a>\n</nav>\n<!-- Settings Content Area -->\n<section class=\"flex-1 max-w-[720px] bg-surface dark:bg-surface-dim border border-outline-variant dark:border-outline rounded-xl p-lg lg:p-xl shadow-sm\">\n<h3 class=\"font-h2 text-h2 text-on-surface dark:text-inverse-on-surface mb-lg pb-sm border-b border-outline-variant dark:border-outline\">Appearance</h3>\n<!-- Theme Section -->\n<div class=\"mb-2xl\">\n<div class=\"mb-md\">\n<h4 class=\"font-h3 text-h3 text-on-surface dark:text-inverse-on-surface mb-xs\">Theme</h4>\n<p class=\"font-body-md text-body-md text-on-surface-variant dark:text-outline\">Customize the visual theme of your workspace.</p>\n</div>\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-md\">\n<!-- Theme Option: Light -->\n<label class=\"relative cursor-pointer group\">\n<input class=\"peer sr-only\" name=\"theme\" type=\"radio\" value=\"light\"/>\n<div class=\"border border-outline-variant dark:border-outline rounded-lg p-md transition-all group-hover:border-primary peer-checked:border-primary peer-checked:bg-surface-container-low dark:peer-checked:bg-surface-container-lowest peer-checked:ring-1 peer-checked:ring-primary flex flex-col items-center gap-sm\">\n<div class=\"w-full h-24 bg-surface-bright rounded-md border border-outline-variant flex items-center justify-center mb-sm overflow-hidden relative\">\n<!-- Mockup UI inside -->\n<div class=\"absolute inset-0 bg-white flex flex-col\">\n<div class=\"h-4 bg-gray-100 border-b border-gray-200 flex items-center px-2\"><div class=\"w-16 h-1 bg-gray-300 rounded\"></div></div>\n<div class=\"flex-1 flex px-2 py-2 gap-2\">\n<div class=\"w-8 bg-gray-50 rounded border border-gray-100\"></div>\n<div class=\"flex-1 bg-gray-50 rounded border border-gray-100\"></div>\n</div>\n</div>\n</div>\n<span class=\"font-body-md text-body-md font-medium text-on-surface dark:text-outline flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[18px]\">light_mode</span>\n                                        Light\n                                    </span>\n</div>\n</label>\n<!-- Theme Option: Dark (Active) -->\n<label class=\"relative cursor-pointer group\">\n<input checked=\"\" class=\"peer sr-only\" name=\"theme\" type=\"radio\" value=\"dark\"/>\n<div class=\"border border-outline-variant dark:border-outline rounded-lg p-md transition-all group-hover:border-primary peer-checked:border-primary peer-checked:bg-surface-container-low dark:peer-checked:bg-surface-container-lowest peer-checked:ring-1 peer-checked:ring-primary flex flex-col items-center gap-sm\">\n<div class=\"w-full h-24 bg-surface-dim rounded-md border border-outline flex items-center justify-center mb-sm overflow-hidden relative\">\n<!-- Mockup UI inside -->\n<div class=\"absolute inset-0 bg-gray-900 flex flex-col\">\n<div class=\"h-4 bg-gray-800 border-b border-gray-700 flex items-center px-2\"><div class=\"w-16 h-1 bg-gray-600 rounded\"></div></div>\n<div class=\"flex-1 flex px-2 py-2 gap-2\">\n<div class=\"w-8 bg-gray-800 rounded border border-gray-700\"></div>\n<div class=\"flex-1 bg-gray-800 rounded border border-gray-700\"></div>\n</div>\n</div>\n</div>\n<span class=\"font-body-md text-body-md font-medium text-on-surface dark:text-inverse-on-surface flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[18px]\">dark_mode</span>\n                                        Dark\n                                    </span>\n</div>\n</label>\n<!-- Theme Option: System -->\n<label class=\"relative cursor-pointer group\">\n<input class=\"peer sr-only\" name=\"theme\" type=\"radio\" value=\"system\"/>\n<div class=\"border border-outline-variant dark:border-outline rounded-lg p-md transition-all group-hover:border-primary peer-checked:border-primary peer-checked:bg-surface-container-low dark:peer-checked:bg-surface-container-lowest peer-checked:ring-1 peer-checked:ring-primary flex flex-col items-center gap-sm\">\n<div class=\"w-full h-24 bg-gradient-to-r from-surface-bright to-surface-dim rounded-md border border-outline-variant flex items-center justify-center mb-sm overflow-hidden relative\">\n<!-- Mockup UI inside -->\n<div class=\"absolute inset-0 flex\">\n<div class=\"flex-1 bg-white flex flex-col\">\n<div class=\"h-4 bg-gray-100 border-b border-gray-200\"></div>\n<div class=\"flex-1\"></div>\n</div>\n<div class=\"flex-1 bg-gray-900 flex flex-col\">\n<div class=\"h-4 bg-gray-800 border-b border-gray-700\"></div>\n<div class=\"flex-1\"></div>\n</div>\n</div>\n</div>\n<span class=\"font-body-md text-body-md font-medium text-on-surface dark:text-outline flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[18px]\">desktop_windows</span>\n                                        System\n                                    </span>\n</div>\n</label>\n</div>\n</div>\n<!-- Display Density Section -->\n<div class=\"mb-lg\">\n<div class=\"mb-md\">\n<h4 class=\"font-h3 text-h3 text-on-surface dark:text-inverse-on-surface mb-xs\">Display Density</h4>\n<p class=\"font-body-md text-body-md text-on-surface-variant dark:text-outline\">Adjust the vertical spacing of list items and tables.</p>\n</div>\n<div class=\"space-y-sm\">\n<!-- Density: Comfortable -->\n<label class=\"flex items-start gap-md p-md rounded-lg border border-outline-variant dark:border-outline hover:bg-surface-container-low dark:hover:bg-surface-container-lowest transition-colors cursor-pointer group relative\">\n<div class=\"pt-xs\">\n<input checked=\"\" class=\"w-4 h-4 text-primary bg-surface border-outline-variant focus:ring-primary focus:ring-2 dark:bg-surface-dim dark:border-outline\" name=\"density\" type=\"radio\" value=\"comfortable\"/>\n</div>\n<div class=\"flex-1\">\n<div class=\"font-body-md font-medium text-on-surface dark:text-inverse-on-surface mb-xs\">Comfortable</div>\n<div class=\"font-body-sm text-on-surface-variant dark:text-outline mb-md\">More spacing between elements. Better for touch devices or scanning text.</div>\n<!-- Visual Indicator -->\n<div class=\"border border-outline-variant dark:border-outline rounded bg-surface dark:bg-surface-dim p-sm flex flex-col gap-sm opacity-70 group-hover:opacity-100 transition-opacity\">\n<div class=\"h-8 bg-surface-container-high dark:bg-surface-container-highest rounded-sm w-full\"></div>\n<div class=\"h-8 bg-surface-container-high dark:bg-surface-container-highest rounded-sm w-full\"></div>\n<div class=\"h-8 bg-surface-container-high dark:bg-surface-container-highest rounded-sm w-3/4\"></div>\n</div>\n</div>\n</label>\n<!-- Density: Compact -->\n<label class=\"flex items-start gap-md p-md rounded-lg border border-outline-variant dark:border-outline hover:bg-surface-container-low dark:hover:bg-surface-container-lowest transition-colors cursor-pointer group relative\">\n<div class=\"pt-xs\">\n<input class=\"w-4 h-4 text-primary bg-surface border-outline-variant focus:ring-primary focus:ring-2 dark:bg-surface-dim dark:border-outline\" name=\"density\" type=\"radio\" value=\"compact\"/>\n</div>\n<div class=\"flex-1\">\n<div class=\"font-body-md font-medium text-on-surface dark:text-inverse-on-surface mb-xs\">Compact</div>\n<div class=\"font-body-sm text-on-surface-variant dark:text-outline mb-md\">Maximum information density. Ideal for large datasets or power users.</div>\n<!-- Visual Indicator -->\n<div class=\"border border-outline-variant dark:border-outline rounded bg-surface dark:bg-surface-dim p-sm flex flex-col gap-[4px] opacity-70 group-hover:opacity-100 transition-opacity\">\n<div class=\"h-5 bg-surface-container-high dark:bg-surface-container-highest rounded-sm w-full\"></div>\n<div class=\"h-5 bg-surface-container-high dark:bg-surface-container-highest rounded-sm w-full\"></div>\n<div class=\"h-5 bg-surface-container-high dark:bg-surface-container-highest rounded-sm w-full\"></div>\n<div class=\"h-5 bg-surface-container-high dark:bg-surface-container-highest rounded-sm w-3/4\"></div>\n</div>\n</div>\n</label>\n</div>\n</div>\n<!-- Action Buttons -->\n<div class=\"mt-xl pt-lg border-t border-outline-variant dark:border-outline flex justify-end gap-md\">\n<button class=\"px-lg py-sm font-label-md text-label-md text-on-surface dark:text-inverse-on-surface border border-outline-variant dark:border-outline rounded hover:bg-surface-container-low dark:hover:bg-surface-container-lowest transition-colors\">Discard Changes</button>\n<button class=\"px-lg py-sm font-label-md text-label-md bg-primary text-on-primary rounded hover:bg-primary-fixed-dim transition-colors\">Save Preferences</button>\n</div>\n</section>\n</div>\n</div>\n</main>" }}
    />
  );
}
