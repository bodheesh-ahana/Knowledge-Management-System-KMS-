an>\n                Internal Tracker\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-md text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px] text-outline group-hover:text-on-surface\">analytics</span>\n                Analytics\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-md text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px] text-outline group-hover:text-on-surface\">description</span>\n                Documents\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-md text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px] text-outline group-hover:text-on-surface\">notifications</span>\n                Notifications\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-md text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px] text-outline group-hover:text-on-surface\">group</span>\n                Users\n            </a>\n<!-- Active State -->\n<a class=\"flex items-center gap-md px-md py-sm rounded-md bg-secondary-container dark:bg-secondary-container text-on-secondary-container dark:text-on-secondary-container border-l-2 border-primary transition-all duration-200 ease-