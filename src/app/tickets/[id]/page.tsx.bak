export default function TicketDetailsPage() {
  return (
    <div className="bg-background text-on-background font-body-md min-h-screen flex antialiased"
      dangerouslySetInnerHTML={{ __html: "<!-- Top Navigation (Mobile only, hidden on md+) -->\n<nav class=\"md:hidden sticky top-0 z-50 flex items-center justify-between px-lg w-full h-[56px] border-b border-outline-variant dark:border-outline-variant bg-surface dark:bg-surface transition-all duration-150\">\n<div class=\"flex items-center gap-sm\">\n<span class=\"material-symbols-outlined text-primary dark:text-inverse-primary\" data-icon=\"menu\">menu</span>\n<span class=\"font-h3 text-h3 font-bold text-on-surface dark:text-on-surface\">KMS Engine</span>\n</div>\n<div class=\"flex items-center gap-md\">\n<span class=\"material-symbols-outlined text-on-surface-variant dark:text-on-surface-variant\" data-icon=\"search\">search</span>\n<div class=\"w-8 h-8 rounded-full overflow-hidden bg-surface-variant\">\n<img alt=\"User Profile\" class=\"object-cover w-full h-full\" data-alt=\"A small, professional headshot portrait of a support engineer in a bright, modern corporate environment. The lighting is soft and even, highlighting a friendly but focused expression. Light mode aesthetic with clean background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBHUjzWlS0_DjbAGDjzYXSUaXQi_y61cx6sjrtMwoPmM9mkKJdharI0_XYttVC-TNFjMqj3uFmI0Jg-68WN36Lz1qXaX6H5lXcr18kj66SqsV7lNyky3RLTj_69QHF-haij0kNbARvPNRBwSFRBDiiAnOviID7PC5nIEbkdYwqlf1MJ4pu3KVwjVDShK1Goq4-vWs3adE1yBOKTDAp-Datz6GhkN1ivUYLdmU5ZmJ_YIumL79T-BFF7FBtH0--gk18aRfmlJUQDrK0W\"/>\n</div>\n</div>\n</nav>\n<!-- SideNavBar (Web only, hidden on mobile) -->\n<aside class=\"hidden md:flex w-sidebar-width h-screen border-r border-outline-variant dark:border-outline-variant bg-surface dark:bg-surface flex-col py-lg shrink-0 sticky top-0 z-40 transition-colors duration-200\">\n<!-- Brand/Header -->\n<div class=\"px-lg mb-xl flex items-center gap-md\">\n<div class=\"w-10 h-10 rounded-DEFAULT bg-primary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-primary fill\" data-icon=\"hub\">hub</span>\n</div>\n<div>\n<h1 class=\"font-h3 text-h3 font-bold text-on-surface dark:text-on-surface\">KMS Engine</h1>\n<p class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Enterprise Support</p>\n</div>\n</div>\n<!-- Primary CTA -->\n<div class=\"px-lg mb-lg\">\n<button class=\"w-full flex items-center justify-center gap-sm h-10 bg-primary text-on-primary rounded-DEFAULT font-label-md text-label-md transition-colors hover:bg-primary-container\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"add\">add</span>\n                New Entry\n            </button>\n</div>\n<!-- Navigation Links -->\n<nav class=\"flex-1 px-sm space-y-1 overflow-y-auto\">\n<a class=\"flex items-center gap-md px-md py-sm rounded-DEFAULT text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-container-low transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-body-md text-body-md font-medium\">Dashboard</span>\n</a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-DEFAULT text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-container-low transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"menu_book\">menu_book</span>\n<span class=\"font-body-md text-body-md font-medium\">Knowledge Base</span>\n</a>\n<!-- Active State -->\n<a class=\"flex items-center gap-md px-md py-sm rounded-DEFAULT bg-surface-container-high dark:bg-surface-container-high text-primary dark:text-inverse-primary border-l-2 border-primary transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px] fill\" data-icon=\"confirmation_number\">confirmation_number</span>\n<span class=\"font-body-md text-body-md font-medium\">Tickets</span>\n</a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-DEFAULT text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-container-low transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"apps\">apps</span>\n<span class=\"font-body-md text-body-md font-medium\">Applications</span>\n</a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-DEFAULT text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-container-low transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"analytics\">analytics</span>\n<span class=\"font-body-md text-body-md font-medium\">Internal Tracker</span>\n</a>\n</nav>\n<!-- Footer Links -->\n<div class=\"px-sm mt-auto pt-lg space-y-1\">\n<a class=\"flex items-center gap-md px-md py-sm rounded-DEFAULT text-on-surface-variant hover:bg-surface-container transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"settings\">settings</span>\n<span class=\"font-body-md text-body-md font-medium\">Settings</span>\n</a>\n<a class=\"flex items-center gap-md px-md py-sm rounded-DEFAULT text-on-surface-variant hover:bg-surface-container transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"description\">description</span>\n<span class=\"font-body-md text-body-md font-medium\">Documentation</span>\n</a>\n<div class=\"mt-md px-md flex items-center gap-sm\">\n<div class=\"w-8 h-8 rounded-full overflow-hidden bg-surface-variant shrink-0 border border-outline-variant\">\n<img alt=\"Engineer Avatar\" class=\"object-cover w-full h-full\" data-alt=\"A small, professional headshot portrait of a support engineer in a bright, modern corporate environment. Light mode aesthetic with clean background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDoxmCoGVxrvLXAVsFBcE7c29UZQ3_f1nZzQbhFsYt0x5UYDJZeNVVXyPpCoRJPgZ5ewku_eisiyO39QQJmYerocn86bwOta0QW8nMYEhOPc-2Ail-9oJq575rDJg-g_OsayOSdmJ6I5hLGgypf-owCzSakP_wl_5ErvOAYDTpOOh2KyAt-vHuqTArbqVLtcOAl7uIPpujmdyZ5shf_mqLMifszovB0YLZM5Hz0ohncJYjLGXIKNk99mumdyTJtEL_9xkq2Oi8uRu8K\"/>\n</div>\n<div class=\"truncate text-on-surface-variant\">\n<p class=\"font-label-md text-label-md font-medium truncate\">J. Doe</p>\n<p class=\"font-body-sm text-body-sm opacity-70 truncate\">L2 Support</p>\n</div>\n</div>\n</div>\n</aside>\n<!-- Main Content Area -->\n<main class=\"flex-1 flex flex-col min-w-0 bg-background relative h-screen overflow-hidden\">\n<!-- Top Nav Header (Contextual to Workspace) -->\n<header class=\"hidden md:flex items-center justify-between px-lg h-[56px] border-b border-outline-variant bg-surface shrink-0 z-30 sticky top-0 w-full transition-all duration-150\">\n<div class=\"flex items-center gap-md text-on-surface-variant\">\n<button class=\"hover:text-on-surface transition-colors\">\n<span class=\"material-symbols-outlined\" data-icon=\"arrow_back\">arrow_back</span>\n</button>\n<div class=\"flex items-center gap-sm font-label-md text-label-md\">\n<span class=\"hover:underline cursor-pointer\">Tickets</span>\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"chevron_right\">chevron_right</span>\n<span class=\"text-on-surface font-medium\">#INC-8492</span>\n</div>\n</div>\n<div class=\"flex items-center gap-lg\">\n<!-- Global Search Placeholder -->\n<div class=\"relative w-64\">\n<span class=\"material-symbols-outlined absolute left-2 top-1/2 -translate-y-1/2 text-[18px] text-on-surface-variant\" data-icon=\"search\">search</span>\n<input class=\"w-full h-8 pl-8 pr-3 bg-surface-container border border-outline-variant rounded-DEFAULT font-body-sm text-body-sm text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all\" placeholder=\"Search workspace...\" type=\"text\"/>\n</div>\n<div class=\"flex items-center gap-sm text-on-surface-variant\">\n<button class=\"w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors\">\n<span class=\"material-symbols-outlined\" data-icon=\"notifications\">notifications</span>\n</button>\n<button class=\"w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors\">\n<span class=\"material-symbols-outlined\" data-icon=\"help_outline\">help_outline</span>\n</button>\n</div>\n</div>\n</header>\n<!-- Workspace Scrollable Area -->\n<div class=\"flex-1 overflow-auto flex flex-col md:flex-row\">\n<!-- Left Column: Timeline & Conversation (Canvas) -->\n<section class=\"flex-1 min-w-0 flex flex-col p-md md:p-lg border-r border-outline-variant\">\n<!-- Ticket Header Content -->\n<div class=\"mb-lg pb-md border-b border-outline-variant\">\n<div class=\"flex items-start justify-between mb-sm\">\n<h2 class=\"font-h2 text-h2 font-semibold text-on-surface tracking-tight\">Database Connectivity Failure in EU-West-1 Production</h2>\n<div class=\"flex items-center gap-xs\">\n<span class=\"px-2 py-1 rounded bg-error-container text-on-error-container font-label-md text-label-md uppercase tracking-wider\">P1 - Critical</span>\n</div>\n</div>\n<div class=\"flex items-center gap-md text-on-surface-variant font-body-sm text-body-sm\">\n<span class=\"flex items-center gap-xs\"><span class=\"material-symbols-outlined text-[16px]\" data-icon=\"person\">person</span> Reporter: Sarah Jenkins</span>\n<span class=\"flex items-center gap-xs\"><span class=\"material-symbols-outlined text-[16px]\" data-icon=\"schedule\">schedule</span> Opened: 2h ago</span>\n</div>\n</div>\n<!-- Conversation Timeline -->\n<div class=\"flex-1 overflow-y-auto space-y-xl pr-sm mb-lg\">\n<!-- Event: System Note -->\n<div class=\"flex gap-md relative\">\n<div class=\"absolute left-4 top-8 bottom-[-2rem] w-px bg-outline-variant -z-10\"></div>\n<div class=\"w-8 h-8 rounded-full bg-surface-container-high border-2 border-surface flex items-center justify-center shrink-0 z-10\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\" data-icon=\"info\">info</span>\n</div>\n<div class=\"flex-1 pt-1\">\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Automated alert triggered by Datadog integration. Multiple connection timeouts observed on <code class=\"font-mono text-mono bg-surface-container px-1 py-0.5 rounded\">db-cluster-eu-w1-a</code>.</p>\n<span class=\"font-label-md text-label-md text-outline mt-1 block\">10:42 AM</span>\n</div>\n</div>\n<!-- Event: User Message -->\n<div class=\"flex gap-md relative\">\n<div class=\"absolute left-4 top-8 bottom-[-2rem] w-px bg-outline-variant -z-10\"></div>\n<div class=\"w-8 h-8 rounded-full bg-surface-variant border-2 border-surface overflow-hidden shrink-0 z-10\">\n<img alt=\"Sarah Jenkins\" class=\"object-cover w-full h-full\" data-alt=\"A clean, minimalist portrait of a female software developer looking concerned, set against a plain light gray background. Studio lighting, highly professional, enterprise application style.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDJBK9f30uT4w6joHbhSNPxpbM8qcNy726p_MuiyPHIIPNyzRm2DtTHmoayNL4z0CCpTjFewHcosxMSvzjW-uY6JkHBJ--ombVa1JSJC-0bVdBsKBa275FF_SnOe4xbgkGJMZkIe9Oz_mwv64SUyunWgkcpY35OyQfSdDUlfOW-JnQgxSJ0wD4PjhlsBF_nGCi_6xwbEZnCyVhwIi5886NqlemY7fPbLzVeglqL-UdwCP6Rv4zT19wzZLe-GiGpRE13Bvm1A2b9i2ip\"/>\n</div>\n<div class=\"flex-1 bg-surface-container-lowest border border-outline-variant rounded-lg p-md shadow-sm\">\n<div class=\"flex justify-between items-center mb-sm\">\n<span class=\"font-label-md text-label-md font-semibold text-on-surface\">Sarah Jenkins (Reporter)</span>\n<span class=\"font-label-md text-label-md text-outline\">10:45 AM</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface mb-md\">\n                                We are seeing complete failure for microservices trying to reach the primary read replica in eu-west-1. Application logs show generic timeout errors. No changes were deployed in the last 24 hours. Impacting checkout flow.\n                            </p>\n<!-- Attachment -->\n<div class=\"flex items-center gap-sm p-sm bg-surface-container-low rounded border border-outline-variant w-fit\">\n<span class=\"material-symbols-outlined text-on-surface-variant\" data-icon=\"insert_drive_file\">insert_drive_file</span>\n<span class=\"font-body-sm text-body-sm text-on-surface\">app-errors-1045.log</span>\n<span class=\"font-body-sm text-body-sm text-outline ml-md\">1.2 MB</span>\n</div>\n</div>\n</div>\n<!-- Event: Internal Note -->\n<div class=\"flex gap-md relative\">\n<div class=\"absolute left-4 top-8 bottom-[-2rem] w-px bg-outline-variant -z-10\"></div>\n<div class=\"w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container border-2 border-surface flex items-center justify-center shrink-0 z-10\">\n<span class=\"material-symbols-outlined text-[16px] fill\" data-icon=\"lock\">lock</span>\n</div>\n<div class=\"flex-1 bg-[#fff8e6] border border-[#f5d085] rounded-lg p-md shadow-sm dark:bg-[#3d3215] dark:border-[#7a642a]\">\n<div class=\"flex justify-between items-center mb-xs\">\n<span class=\"font-label-md text-label-md font-semibold text-[#8a6813] dark:text-[#f5d085] flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"visibility_off\">visibility_off</span>\n                                    Internal Note (L2 Support)\n                                </span>\n<span class=\"font-label-md text-label-md text-[#8a6813] dark:text-[#f5d085] opacity-70\">11:15 AM</span>\n</div>\n<p class=\"font-body-md text-body-md text-[#5c450c] dark:text-[#f7e0a8]\">\n                                I'm checking the AWS dashboard. There's an active incident reported for RDS in that specific availability zone. Not an isolated issue on our end. Escalating to CloudOps immediately.\n                            </p>\n</div>\n</div>\n</div>\n<!-- Reply Composer Area -->\n<div class=\"mt-auto border border-outline-variant rounded-lg bg-surface-container-lowest overflow-hidden focus-within:ring-2 focus-within:ring-primary focus-within:border-transparent transition-all shadow-sm\">\n<div class=\"flex items-center gap-xs p-xs border-b border-outline-variant bg-surface-container-low\">\n<button class=\"p-1 rounded hover:bg-surface-container text-on-surface-variant transition-colors\" title=\"Format Text\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"format_bold\">format_bold</span>\n</button>\n<button class=\"p-1 rounded hover:bg-surface-container text-on-surface-variant transition-colors\" title=\"Attach File\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"attach_file\">attach_file</span>\n</button>\n<button class=\"p-1 rounded hover:bg-surface-container text-on-surface-variant transition-colors ml-auto flex items-center gap-xs font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"visibility_off\">visibility_off</span> Add Internal Note\n                        </button>\n</div>\n<textarea class=\"w-full h-24 p-md bg-transparent border-none resize-none focus:ring-0 font-body-md text-body-md text-on-surface placeholder:text-outline\" placeholder=\"Type a reply...\"></textarea>\n<div class=\"flex items-center justify-between p-sm bg-surface-container-lowest border-t border-outline-variant\">\n<div class=\"flex items-center gap-sm\">\n<div class=\"w-6 h-6 rounded-full overflow-hidden bg-surface-variant border border-outline-variant\">\n<img alt=\"Engineer Avatar\" class=\"object-cover w-full h-full\" data-alt=\"A small, professional headshot portrait of a support engineer in a bright, modern corporate environment. Light mode aesthetic with clean background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCRX3F9_ZwroBKv88MZmZTvOxpSA4ScbXVAj2ExoI9PeiGasKFFY5RhLJ-F4sT1OJdON6Em425Dl7rf-Ho9-_7cNSXMRBF7Bd-OOST5fv0AWsw0N6G1MXutMW3Iqf_JakbGVN3ugfl7UYPVjKn-OE93OXfQvE95COQ0DVzdT-Er1IYr_-Vg67EOuMQShMPd-W63L8iohtP7wMBhNuVpisQMFi0pX5auPFGj7ly-OBrQvd3FvjLE-0U8GyMfaEbMUrGMdLamKZUQITO1\"/>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Replying as <strong class=\"text-on-surface\">J. Doe</strong></span>\n</div>\n<div class=\"flex gap-sm\">\n<button class=\"px-md py-sm rounded-DEFAULT border border-outline-variant text-on-surface font-label-md text-label-md hover:bg-surface-container-low transition-colors\">\n                                Resolve\n                            </button>\n<button class=\"px-md py-sm rounded-DEFAULT bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container flex items-center gap-xs transition-colors shadow-sm\">\n                                Send Reply <span class=\"material-symbols-outlined text-[18px]\" data-icon=\"send\">send</span>\n</button>\n</div>\n</div>\n</div>\n</section>\n<!-- Right Column: Metadata & Related (Contextual Drawer) -->\n<aside class=\"w-full md:w-[320px] shrink-0 bg-surface flex flex-col overflow-y-auto\">\n<!-- Ticket Properties -->\n<div class=\"p-lg border-b border-outline-variant\">\n<h3 class=\"font-h3 text-h3 font-semibold text-on-surface mb-md\">Details</h3>\n<div class=\"space-y-md\">\n<div>\n<label class=\"font-label-md text-label-md text-outline block mb-xs\">Status</label>\n<div class=\"w-full flex items-center justify-between px-sm py-1.5 border border-outline-variant rounded-DEFAULT bg-surface-container-lowest hover:bg-surface-container-low cursor-pointer transition-colors\">\n<div class=\"flex items-center gap-xs\">\n<div class=\"w-2 h-2 rounded-full bg-[#d97706]\"></div> <!-- Orange status -->\n<span class=\"font-body-sm text-body-sm text-on-surface\">Investigating</span>\n</div>\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\" data-icon=\"expand_more\">expand_more</span>\n</div>\n</div>\n<div>\n<label class=\"font-label-md text-label-md text-outline block mb-xs\">Assignee</label>\n<div class=\"w-full flex items-center justify-between px-sm py-1.5 border border-outline-variant rounded-DEFAULT bg-surface-container-lowest hover:bg-surface-container-low cursor-pointer transition-colors\">\n<div class=\"flex items-center gap-sm\">\n<div class=\"w-5 h-5 rounded-full overflow-hidden bg-surface-variant shrink-0 border border-outline-variant\">\n<img alt=\"Engineer Avatar\" class=\"object-cover w-full h-full\" data-alt=\"A small, professional headshot portrait of a support engineer in a bright, modern corporate environment. Light mode aesthetic with clean background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDNAbxbW5LikSBL1Q4ss13TiCphCx1dovBNlXwsdKr85h0A34VjzdlrzODLipVvU4uTni913jfRMFszUkPS1Q6NCIpiFGGA7ffKFdiKUumAP9nKGYcsH4UkxIPhjwtnYZy1d32_BZkfmrv75ZvA8umNUZbjlwPpjwM4UWn_1KHDsNMHNgxWLIMLefgoJT3GWizVGg9Xc7BFAeBU3Pw4tJc6zD3OUvhJo5-o1KSvr-qq5S9bs4Ohu-WoR2WqXs-GqnRvncnCweQwq37v\"/>\n</div>\n<span class=\"font-body-sm text-body-sm text-on-surface\">J. Doe</span>\n</div>\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\" data-icon=\"expand_more\">expand_more</span>\n</div>\n</div>\n<div>\n<label class=\"font-label-md text-label-md text-outline block mb-xs\">Component</label>\n<div class=\"flex flex-wrap gap-xs\">\n<span class=\"inline-flex items-center px-2 py-1 rounded bg-secondary-container text-on-secondary-container font-mono text-mono text-[11px] border border-[#a8c6f7]\">RDS Database</span>\n<span class=\"inline-flex items-center px-2 py-1 rounded bg-surface-container-high text-on-surface font-mono text-mono text-[11px] border border-outline-variant\">EU-West-1</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Related Knowledge Base -->\n<div class=\"p-lg\">\n<div class=\"flex items-center justify-between mb-md\">\n<h3 class=\"font-h3 text-h3 font-semibold text-on-surface\">Suggested Articles</h3>\n<button class=\"text-primary hover:text-primary-container font-label-md text-label-md\">View all</button>\n</div>\n<div class=\"space-y-sm\">\n<!-- Article Card -->\n<a class=\"block p-sm border border-outline-variant rounded-DEFAULT bg-surface-container-lowest hover:bg-surface-container-low transition-colors group\" href=\"#\">\n<div class=\"flex gap-sm\">\n<span class=\"material-symbols-outlined text-secondary mt-0.5\" data-icon=\"article\">article</span>\n<div>\n<h4 class=\"font-body-sm text-body-sm font-medium text-on-surface group-hover:text-primary transition-colors leading-tight mb-1\">Troubleshooting AWS RDS Timeout Errors</h4>\n<div class=\"flex items-center gap-xs font-label-md text-label-md text-outline\">\n<span>Infrastructure</span> • <span>Updated 2w ago</span>\n</div>\n</div>\n</div>\n</a>\n<!-- Article Card -->\n<a class=\"block p-sm border border-outline-variant rounded-DEFAULT bg-surface-container-lowest hover:bg-surface-container-low transition-colors group\" href=\"#\">\n<div class=\"flex gap-sm\">\n<span class=\"material-symbols-outlined text-secondary mt-0.5\" data-icon=\"article\">article</span>\n<div>\n<h4 class=\"font-body-sm text-body-sm font-medium text-on-surface group-hover:text-primary transition-colors leading-tight mb-1\">Escalation Matrix for P1 Outages</h4>\n<div class=\"flex items-center gap-xs font-label-md text-label-md text-outline\">\n<span>Process</span> • <span>Updated 1mo ago</span>\n</div>\n</div>\n</div>\n</a>\n</div>\n</div>\n</aside>\n</div>\n</main>" }}
    />
