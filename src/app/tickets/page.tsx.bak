xt-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-container-low transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 20px;\">apps</span>\n                Applications\n            </a>\n<a class=\"flex items-center gap-3 px-3 py-2 rounded bg-surface-container-high dark:bg-surface-container-high text-primary dark:text-inverse-primary border-l-2 border-primary transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">analytics</span>\n                Internal Tracker\n            </a>\n</nav>\n<div class=\"px-sm mt-auto pt-lg space-y-1\">\n<a class=\"flex items-center gap-3 px-3 py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-container-low transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 20px;\">settings</span>\n                Settings\n            </a>\n<a class=\"flex items-center gap-3 px-3 py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-container-low transition-colors duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 20px;\">description</span>\n                Documentation\n            </a>\n</div>\n</aside>\n<!-- Main Content Area -->\n<main class=\"flex-1 flex flex-col h-screen overflow-hidden\">\n<!-- TopNavBar -->\n<header class=\"sticky top-0 z-50 flex items-center justify-between px-lg w-full h-[56px] border-b border-outline-variant dark:border-outline-variant bg-surface dark:bg-surface\">\n<div class=\"flex items-center gap-lg\">\n<div class=\"md:hidden font-h3 text-h3 font-bold text-on-surface\">KMS Engine</div>\n<div class=\"hidden md:flex items-center gap-md\">\n<div class=\"relative\">\n<span class=\"material-symbols-outlined absolute left-3 top-1/2