ontent.com/aida-public/AB6AXuAQdbiuPWYWjglXU5SAIMyr40K32idvgpNg0n9dMYz3pBtbDjBuIpVVOdRmg2iPbg6ky1eH8H0jf-ZvXj3Q2s5-03Nx-Y4qvgOJltHou8fMti2k4rKsFHZ02hLkiFKV17Xr6U9NtIO4cgBzCVvW3K2IrpVTW9QLcYNnr2bjyLUft62vL8V0Y3x2MzBZV1-Z9DbvnpbkF2Cbktug5v3fsZgarVC5fjKnEFOitGGQMf8gIw_C0X6ct6ustlI4osbySUddzcvDKmx6mjWS\"/>\n</div>\n</div>\n</div>\n</header>\n<!-- Canvas -->\n<div class=\"flex-1 overflow-auto p-md lg:p-lg\">\n<div class=\"max-w-[1440px] mx-auto w-full flex flex-col h-full gap-md\">\n<!-- Page Header & Filters -->\n<div class=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-sm\">\n<div>\n<h2 class=\"font-h2 text-h2 font-semibold text-on-background\">Internal Reference Tracker</h2>\n<p class=\"text-body-sm text-on-surface-variant mt-1\">Global view of all internal tickets and associated knowledge base articles.</p>\n</div>\n<div class=\"flex flex-wrap items-center gap-2 w-full sm:w-auto\">\n<div class=\"relative\">\n<select class=\"appearance-none h-[32px] pl-3 pr-8 rounded bg-surface border border-outline-variant text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow cursor-pointer\">\n<option>All Applications</option>\n<option>CRM Portal</option>\n<option>Billing System</option>\n<option>Auth Service</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\" style=\"font-size: 16px;\">expand_more</span>\n</div>\n<div class=\"relative\">\n<select class=\"appearance-none h-[32px] pl-3 pr-8 rounded bg-surface border border-outline-variant text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow cursor-pointer\">\n<option>Status: All</option>\n<option>Open</option>\n<option>In Progress</option>\n<option>Resolved</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none\" style=\"font-size: 16px;\">expand_more</span>\n</div>\n<button class=\"h-[32px] px-3 flex items-center gap-2 rounded bg-surface border border-outline-variant text-body-sm text-on-surface hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 16px;\">filter_list</span>\n                            More Filters\n                        </button>\n<button class=\"h-[32px] w-[32px] flex items-center justify-center rounded bg-surface border border-outline-variant text-on-surface hover:bg-surface-container transition-colors ml-auto sm:ml-2\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 16px;\">download</span>\n</button>\n</div>\n</div>\n<!-- Table Container (Bento/Card style wrapper) -->\n<div class=\"flex-1 bg-surface border border-subtle rounded-lg flex flex-col min-h-[500px]\">\n<!-- Table Header -->\n<div class=\"grid grid-cols-12 gap-4 px-4 py-3 border-b border-outline-variant bg-surface-container-lowest text-label-md text-on-surface-variant sticky top-0 z-10 rounded-t-lg\">\n<div class=\"col-span-2 sm:col-span-1\">Ticket #</div>\n<div class=\"col-span-5 sm:col-span-3\">Issue Summary</div>\n<div class=\"hidden sm:block col-span-2\">Application</div>\n<div class=\"hidden lg:block col-span-1\">Requester</div>\n<div class=\"hidden md:block col-span-1\">Owner</div>\n<div class=\"col-span-2 sm:col-span-1 text-center\">Priority</div>\n<div class=\"col-span-2 sm:col-span-1 text-center\">Status</div>\n<div class=\"hidden lg:block col-span-2 text-right\">Knowledge Linked</div>\n</div>\n<!-- Table Body -->\n<div class=\"flex-1 overflow-y-auto\">\n<!-- Row 1 -->\n<div class=\"grid grid-cols-12 gap-4 px-4 py-3 border-b border-outline-variant hover:bg-surface-container-low transition-colors group cursor-pointer items-center text-body-sm text-on-surface\">\n<div class=\"col-span-2 sm:col-span-1 font-mono text-mono text-on-surface-variant\">#4092</div>\n<div class=\"col-span-5 sm:col-span-3 font-medium truncate group-hover:text-primary transition-colors\">OAuth Token Expiration Failure</div>\n<div class=\"hidden sm:block col-span-2 truncate text-on-surface-variant\">Auth Service</div>\n<div class=\"hidden lg:flex col-span-1 items-center gap-2\">\n<div class=\"w-5 h-5 rounded-full bg-tertiary-container text-on-tertiary flex items-center justify-center text-[10px] font-bold\">JD</div>\n<span class=\"truncate\">J. Doe</span>\n</div>\n<div class=\"hidden md:flex col-span-1 items-center gap-2\">\n<div class=\"w-5 h-5 rounded-full bg-primary-container text-on-primary flex items-center justify-center text-[10px] font-bold\">AS</div>\n<span class=\"truncate\">A. Smith</span>\n</div>\n<div class=\"col-span-2 sm:col-span-1 flex justify-center\">\n<span class=\"inline-flex items-center px-1.5 py-0.5 rounded-sm bg-error-container text-on-error-container text-[10px] font-semibold tracking-wide uppercase\">High</span>\n</div>\n<div class=\"col-span-2 sm:col-span-1 flex justify-center\">\n<span class=\"inline-flex items-center gap-1 text-on-surface-variant text-[11px] font-medium\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary\"></span>\n                                    Open\n                                </span>\n</div>\n<div class=\"hidden lg:flex col-span-2 justify-end items-center gap-2\">\n<span class=\"material-symbols-outlined text-outline\" style=\"font-size: 16px;\">link</span>\n<span class=\"text-primary hover:underline truncate max-w-[120px]\">KB-Auth-Refresh</span>\n</div>\n</div>\n<!-- Row 2 -->\n<div class=\"grid grid-cols-12 gap-4 px-4 py-3 border-b border-outline-variant hover:bg-surface-container-low transition-colors group cursor-pointer items-center text-body-sm text-on-surface\">\n<div class=\"col-span-2 sm:col-span-1 font-mono text-mono text-on-surface-variant\">#4091</div>\n<div class=\"col-span-5 sm:col-span-3 font-medium truncate group-hover:text-primary transition-colors\">Data Export Timeout &gt; 50k rows</div>\n<div class=\"hidden sm:block col-span-2 truncate text-on-surface-variant\">Reporting DB</div>\n<div class=\"hidden lg:flex col-span-1 items-center gap-2\">\n<div class=\"w-5 h-5 rounded-full bg-tertiary-container text-on-tertiary flex items-center justify-center text-[10px] font-bold\">MR</div>\n<span class=\"truncate\">M. Ross</span>\n</div>\n<div class=\"hidden md:flex col-span-1 items-center gap-2\">\n<div class=\"w-5 h-5 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-[10px] font-bold\">KL</div>\n<span class=\"truncate\">K. Lee</span>\n</div>\n<div class=\"col-span-2 sm:col-span-1 flex justify-center\">\n<span class=\"inline-flex items-center px-1.5 py-0.5 rounded-sm bg-surface-variant text-on-surface-variant text-[10px] font-semibold tracking-wide uppercase\">Med</span>\n</div>\n<div class=\"col-span-2 sm:col-span-1 flex justify-center\">\n<span class=\"inline-flex items-center gap-1 text-on-surface-variant text-[11px] font-medium\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span>\n                                    In Prog\n                                </span>\n</div>\n<div class=\"hidden lg:flex col-span-2 justify-end items-center gap-2\">\n<span class=\"text-on-surface-variant text-xs italic\">Unlinked</span>\n<button class=\"text-on-surface-variant hover:text-primary opacity-0 group-hover:opacity-100 transition-opacity\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 16px;\">add_link</span>\n</button>\n</div>\n</div>\n<!-- Row 3 -->\n<div class=\"grid grid-cols-12 gap-4 px-4 py-3 border-b border-outline-variant hover:bg-surface-container-low transition-colors group cursor-pointer items-center text-body-sm text-on-surface\">\n<div class=\"col-span-2 sm:col-span-1 font-mono text-mono text-on-surface-variant\">#4088</div>\n<div class=\"col-span-5 sm:col-span-3 font-medium truncate group-hover:text-primary transition-colors text-on-surface-variant line-through\">UI Misalignment in Dashboard Header</div>\n<div class=\"hidden sm:block col-span-2 truncate text-on-surface-variant\">CRM Portal</div>\n<div class=\"hidden lg:flex col-span-1 items-center gap-2\">\n<div class=\"w-5 h-5 rounded-full bg-tertiary-container text-on-tertiary flex items-center justify-center text-[10px] font-bold\">JD</div>\n<span class=\"truncate\">J. Doe</span>\n</div>\n<div class=\"hidden md:flex col-span-1 items-center gap-2\">\n<div class=\"w-5 h-5 rounded-full bg-primary-container text-on-primary flex items-center justify-center text-[10px] font-bold\">AS</div>\n<span class=\"truncate\">A. Smith</span>\n</div>\n<div class=\"col-span-2 sm:col-span-1 flex justify-center\">\n<span class=\"inline-flex items-center px-1.5 py-0.5 rounded-sm bg-surface-container-highest text-on-surface-variant text-[10px] font-semibold tracking-wide uppercase opacity-70\">Low</span>\n</div>\n<div class=\"col-span-2 sm:col-span-1 flex justify-center\">\n<span class=\"inline-flex items-center gap-1 text-on-surface-variant text-[11px] font-medium opacity-70\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 12px;\">check_circle</span>\n                                    Resolved\n                                </span>\n</div>\n<div class=\"hidden lg:flex col-span-2 justify-end items-center gap-2\">\n<span class=\"material-symbols-outlined text-outline\" style=\"font-size: 16px;\">link</span>\n<span class=\"text-primary hover:underline truncate max-w-[120px]\">UI-Guidelines-V2</span>\n</div>\n</div>\n</div>\n<!-- Pagination Footer -->\n<div class=\"px-4 py-3 border-t border-outline-variant bg-surface-container-lowest flex items-center justify-between rounded-b-lg text-body-sm text-on-surface-variant\">\n<div>Showing 1 to 3 of 142 entries</div>\n<div class=\"flex items-center gap-2\">\n<button class=\"w-8 h-8 flex items-center justify-center rounded border border-outline-variant hover:bg-surface-container disabled:opacity-50\" disabled=\"\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 18px;\">chevron_left</span>\n</button>\n<button class=\"w-8 h-8 flex items-center justify-center rounded border border-outline-variant hover:bg-surface-container\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 18px;\">chevron_right</span>\n</button>\n</div>\n</div>\n</div>\n</div>\n</div>\n</main>" }}
