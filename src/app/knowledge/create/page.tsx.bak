export default function CreateKnowledgeArticlePage() {
  return (
    <div className="bg-background dark:bg-on-background text-on-surface dark:text-inverse-on-surface font-body-md antialiased overflow-x-hidden"
      dangerouslySetInnerHTML={{ __html: "<!-- SideNavBar -->\n<nav class=\"fixed left-0 top-0 h-screen w-sidebar-width bg-surface-container-low dark:bg-surface-container-lowest border-r border-outline-variant dark:border-outline flex flex-col py-lg px-md transition-all duration-200 ease-in-out z-50\">\n<!-- Brand/Header -->\n<div class=\"flex items-center gap-sm mb-xl px-sm\">\n<div class=\"w-8 h-8 rounded bg-primary flex items-center justify-center text-on-primary\">\n<span class=\"material-symbols-outlined text-[20px]\" data-weight=\"fill\" style=\"font-variation-settings: 'FILL' 1;\">corporate_fare</span>\n</div>\n<div>\n<h2 class=\"font-h2 text-h2 font-bold text-primary dark:text-primary-fixed-dim tracking-tight leading-none\">KMS</h2>\n<p class=\"font-label-md text-label-md text-on-surface-variant dark:text-outline mt-1 uppercase tracking-wider\">Enterprise Support</p>\n</div>\n</div>\n<!-- Main Navigation Tabs -->\n<div class=\"flex-1 overflow-y-auto\">\n<ul class=\"space-y-1\">\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">dashboard</span><span class=\"font-body-md text-body-md\">Dashboard</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg bg-secondary-container dark:bg-secondary-container text-on-secondary-container dark:text-on-secondary-container border-l-2 border-primary transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">auto_stories</span><span class=\"font-body-md text-body-md font-semibold\">Knowledge Base</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">confirmation_number</span><span class=\"font-body-md text-body-md\">Tickets</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">apps</span><span class=\"font-body-md text-body-md\">Applications</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">track_changes</span><span class=\"font-body-md text-body-md\">Internal Tracker</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">analytics</span><span class=\"font-body-md text-body-md\">Analytics</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">description</span><span class=\"font-body-md text-body-md\">Documents</span></a></li>\n</ul>\n</div>\n<div class=\"mt-auto pt-lg border-t border-outline-variant dark:border-outline\">\n<ul class=\"space-y-1 mb-lg\">\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">notifications</span><span class=\"font-body-md text-body-md\">Notifications</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">group</span><span class=\"font-body-md text-body-md\">Users</span></a></li>\n<li><a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors duration-200\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">settings</span><span class=\"font-body-md text-body-md\">Settings</span></a></li>\n</ul>\n<button class=\"w-full flex items-center justify-center gap-2 py-2 px-4 rounded bg-primary text-on-primary font-label-md text-label-md hover:bg-on-primary-fixed-variant transition-colors\">\n<span class=\"material-symbols-outlined text-[18px]\">add</span> Quick Add\n            </button>\n</div>\n</nav>\n<!-- Main Content Wrapper -->\n<main class=\"ml-sidebar-width min-h-screen flex flex-col\">\n<!-- TopNavBar -->\n<header class=\"sticky top-0 z-40 w-full h-[56px] border-b border-outline-variant dark:border-outline bg-surface dark:bg-surface-dim flex justify-between items-center px-lg transition-colors duration-150\">\n<!-- Left Side / Search Placeholder -->\n<div class=\"flex items-center gap-4 flex-1\">\n<div class=\"relative w-64\">\n<span class=\"material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-outline\">search</span>\n<input class=\"w-full h-8 pl-9 pr-3 rounded border border-outline bg-surface-container-lowest dark:bg-on-background text-on-surface dark:text-inverse-on-surface font-body-sm text-body-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all\" placeholder=\"Search knowledge base...\" type=\"text\"/>\n<div class=\"absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1\">\n<kbd class=\"font-mono text-mono text-[10px] text-outline px-1 border border-outline rounded\">Cmd+K</kbd>\n</div>\n</div>\n</div>\n<!-- Right Side / Actions -->\n<div class=\"flex items-center gap-sm\">\n<button class=\"w-8 h-8 flex items-center justify-center rounded-full text-on-surface-variant dark:text-outline hover:text-primary dark:hover:text-primary-fixed-dim hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">notifications</span>\n</button>\n<button class=\"w-8 h-8 flex items-center justify-center rounded-full text-on-surface-variant dark:text-outline hover:text-primary dark:hover:text-primary-fixed-dim hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all\">\n<span class=\"material-symbols-outlined text-[20px]\">contrast</span>\n</button>\n<div class=\"w-px h-5 bg-outline-variant dark:bg-outline mx-2\"></div>\n<img alt=\"User Profile\" class=\"w-8 h-8 rounded-full border border-outline object-cover cursor-pointer\" data-alt=\"A professional headshot of a corporate employee in a well-lit office, wearing a dark blazer. The lighting is soft and neutral, conveying trust and competence in a modern enterprise setting.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCffl1MlPWXE3jrylk4WAtfuayGE-f4XSW8-QhytN0Nphlkt87n4zZftJzdcPt-NWkdLYqdTqEvDTP0nl5w1WyFRxWOCoo4I2Av7V0ccspvIGi-NsUCUAkzYCq9_YOTtSulgapZOuZT7XLdnja9M-AhC1ViuGbtSkli19nrPdPzTSHi3G5benknw9AVFKmOT7wB61Qxl3pomFj81pO2evn6k1KgqDX7D9blCSiWHKII-dBVEmt9PXSDO5_PAWIEBQpF8osJwNqJEiUR\"/>\n</div>\n</header>\n<!-- Editor Workspace -->\n<div class=\"flex-1 flex flex-col\">\n<!-- Sticky Action Bar for Editor -->\n<div class=\"sticky top-[56px] z-30 bg-surface dark:bg-surface-dim/90 backdrop-blur-sm border-b border-outline px-lg py-3 flex justify-between items-center shadow-sm\">\n<div class=\"flex items-center gap-3\">\n<button class=\"text-on-surface-variant hover:text-primary transition-colors flex items-center\">\n<span class=\"material-symbols-outlined text-[20px]\">arrow_back</span>\n</button>\n<div class=\"h-4 w-px bg-outline mx-1\"></div>\n<div class=\"font-body-sm text-body-sm text-outline flex items-center gap-2\">\n<span>Knowledge Base</span>\n<span class=\"material-symbols-outlined text-[14px]\">chevron_right</span>\n<span>Drafts</span>\n<span class=\"material-symbols-outlined text-[14px]\">chevron_right</span>\n</div>\n<h1 class=\"font-h3 text-h3 text-on-surface dark:text-inverse-on-surface font-semibold m-0 leading-none\">Troubleshooting VPN Connectivity</h1>\n</div>\n<div class=\"flex items-center gap-4\">\n<div class=\"flex items-center gap-1.5 text-tertiary dark:text-tertiary-fixed-dim font-body-sm text-body-sm\">\n<span class=\"material-symbols-outlined text-[14px]\">cloud_done</span>\n<span>Saved just now</span>\n</div>\n<button class=\"px-4 py-1.5 rounded border border-outline text-on-surface dark:text-inverse-on-surface font-label-md text-label-md hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\">\n                        Preview\n                    </button>\n<button class=\"px-4 py-1.5 rounded bg-primary text-on-primary font-label-md text-label-md hover:bg-on-primary-fixed-variant shadow-[0_1px_2px_rgba(0,0,0,0.1)] transition-all\">\n                        Publish Article\n                    </button>\n</div>\n</div>\n<!-- Content Area (Stepper & Editor) -->\n<div class=\"flex-1 max-w-[1000px] w-full mx-auto p-lg grid grid-cols-1 xl:grid-cols-[1fr_280px] gap-xl\">\n<!-- Main Editor Column -->\n<div class=\"flex flex-col gap-xl\">\n<!-- Progress Stepper -->\n<div class=\"flex items-center justify-between w-full relative\">\n<div class=\"absolute left-0 top-1/2 -translate-y-1/2 w-full h-px bg-outline-variant dark:bg-outline z-0\"></div>\n<!-- Step 1: Info (Completed) -->\n<div class=\"relative z-10 flex flex-col items-center gap-2 bg-background dark:bg-on-background px-2\">\n<div class=\"w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm ring-4 ring-background dark:ring-on-background\">\n<span class=\"material-symbols-outlined text-[14px]\" data-weight=\"fill\" style=\"font-variation-settings: 'FILL' 1;\">check</span>\n</div>\n<span class=\"font-label-md text-label-md text-primary font-semibold\">Info</span>\n</div>\n<!-- Step 2: Details (Completed) -->\n<div class=\"relative z-10 flex flex-col items-center gap-2 bg-background dark:bg-on-background px-2\">\n<div class=\"w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm ring-4 ring-background dark:ring-on-background\">\n<span class=\"material-symbols-outlined text-[14px]\" data-weight=\"fill\" style=\"font-variation-settings: 'FILL' 1;\">check</span>\n</div>\n<span class=\"font-label-md text-label-md text-primary font-semibold\">Details</span>\n</div>\n<!-- Step 3: Root Cause (Active) -->\n<div class=\"relative z-10 flex flex-col items-center gap-2 bg-background dark:bg-on-background px-2\">\n<div class=\"w-6 h-6 rounded-full border-2 border-primary bg-surface-container-highest dark:bg-inverse-surface flex items-center justify-center text-primary dark:text-primary-fixed-dim ring-4 ring-background dark:ring-on-background\">\n<span class=\"font-label-md text-label-md\">3</span>\n</div>\n<span class=\"font-label-md text-label-md text-on-surface dark:text-inverse-on-surface font-bold\">Root Cause</span>\n</div>\n<!-- Step 4: Steps (Pending) -->\n<div class=\"relative z-10 flex flex-col items-center gap-2 bg-background dark:bg-on-background px-2\">\n<div class=\"w-6 h-6 rounded-full border border-outline bg-surface dark:bg-surface-dim flex items-center justify-center text-outline ring-4 ring-background dark:ring-on-background\">\n<span class=\"font-label-md text-label-md\">4</span>\n</div>\n<span class=\"font-label-md text-label-md text-outline\">Steps</span>\n</div>\n<!-- Step 5: Resolution (Pending) -->\n<div class=\"relative z-10 flex flex-col items-center gap-2 bg-background dark:bg-on-background px-2\">\n<div class=\"w-6 h-6 rounded-full border border-outline bg-surface dark:bg-surface-dim flex items-center justify-center text-outline ring-4 ring-background dark:ring-on-background\">\n<span class=\"font-label-md text-label-md\">5</span>\n</div>\n<span class=\"font-label-md text-label-md text-outline\">Resolution</span>\n</div>\n<!-- Step 6: Review (Pending) -->\n<div class=\"relative z-10 flex flex-col items-center gap-2 bg-background dark:bg-on-background px-2\">\n<div class=\"w-6 h-6 rounded-full border border-outline bg-surface dark:bg-surface-dim flex items-center justify-center text-outline ring-4 ring-background dark:ring-on-background\">\n<span class=\"font-label-md text-label-md\">6</span>\n</div>\n<span class=\"font-label-md text-label-md text-outline\">Review</span>\n</div>\n</div>\n<!-- Active Step Content: Root Cause Rich Text Editor -->\n<div class=\"mt-4 flex flex-col gap-4 animate-[fadeIn_0.3s_ease-out]\">\n<div>\n<h2 class=\"font-h3 text-h3 font-semibold text-on-surface dark:text-inverse-on-surface\">Explain the Root Cause</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant dark:text-outline mt-1\">Detail the underlying technical reason for the issue to help agents understand context.</p>\n</div>\n<div class=\"border border-outline rounded-lg bg-surface dark:bg-surface-dim overflow-hidden shadow-[0_1px_2px_rgba(0,0,0,0.05)] focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all\">\n<!-- Editor Toolbar -->\n<div class=\"border-b border-outline bg-surface-container-lowest dark:bg-inverse-surface p-2 flex items-center gap-1 flex-wrap\">\n<select class=\"h-8 border border-transparent hover:border-outline bg-transparent rounded font-body-sm text-body-sm text-on-surface dark:text-inverse-on-surface focus:outline-none focus:ring-0\">\n<option>Paragraph</option>\n<option>Heading 1</option>\n<option>Heading 2</option>\n<option>Code Block</option>\n</select>\n<div class=\"w-px h-4 bg-outline mx-1\"></div>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">format_bold</span></button>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">format_italic</span></button>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">format_underlined</span></button>\n<div class=\"w-px h-4 bg-outline mx-1\"></div>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">format_list_bulleted</span></button>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">format_list_numbered</span></button>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">link</span></button>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">image</span></button>\n<div class=\"w-px h-4 bg-outline mx-1\"></div>\n<button class=\"w-8 h-8 rounded flex items-center justify-center text-on-surface dark:text-inverse-on-surface hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors\"><span class=\"material-symbols-outlined text-[18px]\">code</span></button>\n</div>\n<!-- Editor Canvas -->\n<div class=\"p-lg min-h-[300px] outline-none font-body-md text-body-md text-on-surface dark:text-inverse-on-surface cursor-text\" contenteditable=\"true\">\n<p>The most common cause for Error 503 during VPN initialization on macOS Ventura is a conflict with the built-in firewall blocking the virtual network adapter created by the client.</p>\n<br/>\n<p>When the client attempts to establish the <code>utun</code> interface, aggressive firewall rules may silently drop the handshake packets. This usually manifests immediately after an OS update where network extension permissions are reset.</p>\n</div>\n</div>\n<!-- Form Navigation -->\n<div class=\"flex justify-between items-center mt-6 pt-4 border-t border-outline\">\n<button class=\"px-4 py-2 rounded text-secondary dark:text-tertiary-fixed-dim font-label-md text-label-md hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-colors flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px]\">arrow_back</span> Back to Details\n                            </button>\n<button class=\"px-6 py-2 rounded bg-surface-container-highest dark:bg-inverse-surface text-on-surface dark:text-inverse-on-surface border border-outline font-label-md text-label-md hover:border-primary transition-colors flex items-center gap-2\">\n                                Continue to Steps <span class=\"material-symbols-outlined text-[18px]\">arrow_forward</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Side Panel (Metadata & AI) -->\n<aside class=\"flex flex-col gap-6\">\n<!-- AI Assistant Card -->\n<div class=\"border border-outline-variant dark:border-outline rounded-lg bg-surface dark:bg-surface-dim overflow-hidden flex flex-col shadow-[0_2px_4px_-2px_rgba(0,0,0,0.1)]\">\n<div class=\"bg-surface-container-highest dark:bg-inverse-surface px-4 py-3 border-b border-outline flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px] text-primary dark:text-primary-fixed-dim\">auto_awesome</span>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface dark:text-inverse-on-surface\">AI Suggestions</span>\n</div>\n<div class=\"p-4 flex flex-col gap-4\">\n<p class=\"font-body-sm text-body-sm text-on-surface-variant dark:text-outline\">Based on your title and details, consider adding these tags for better searchability:</p>\n<div class=\"flex flex-wrap gap-2\">\n<button class=\"px-2 py-1 rounded-full border border-outline bg-background dark:bg-on-background text-on-surface dark:text-inverse-on-surface font-mono text-[11px] hover:border-primary hover:text-primary transition-colors flex items-center gap-1 group\">\n<span class=\"material-symbols-outlined text-[14px] group-hover:text-primary\">add</span> VPN\n                                </button>\n<button class=\"px-2 py-1 rounded-full border border-outline bg-background dark:bg-on-background text-on-surface dark:text-inverse-on-surface font-mono text-[11px] hover:border-primary hover:text-primary transition-colors flex items-center gap-1 group\">\n<span class=\"material-symbols-outlined text-[14px] group-hover:text-primary\">add</span> macOS\n                                </button>\n<button class=\"px-2 py-1 rounded-full border border-outline bg-background dark:bg-on-background text-on-surface dark:text-inverse-on-surface font-mono text-[11px] hover:border-primary hover:text-primary transition-colors flex items-center gap-1 group\">\n<span class=\"material-symbols-outlined text-[14px] group-hover:text-primary\">add</span> Error 503\n                                </button>\n</div>\n<div class=\"mt-2 p-3 bg-surface-container-low dark:bg-surface-container-lowest rounded border border-outline-variant text-body-sm font-body-sm text-on-surface-variant dark:text-outline italic\">\n                                \"Want me to draft a quick summary for the meta description based on this text?\"\n                            </div>\n<button class=\"w-full py-1.5 rounded text-primary dark:text-primary-fixed-dim font-label-md text-label-md border border-primary/30 hover:bg-primary/5 transition-colors\">\n                                Generate Summary\n                            </button>\n</div>\n</div>\n<!-- Article Settings -->\n<div class=\"border border-outline-variant dark:border-outline rounded-lg bg-surface dark:bg-surface-dim overflow-hidden flex flex-col\">\n<div class=\"px-4 py-3 border-b border-outline\">\n<span class=\"font-label-md text-label-md font-semibold text-on-surface dark:text-inverse-on-surface\">Article Settings</span>\n</div>\n<div class=\"p-4 flex flex-col gap-4\">\n<div>\n<label class=\"font-label-md text-label-md text-on-surface-variant dark:text-outline block mb-1\">Visibility</label>\n<select class=\"w-full h-8 px-2 rounded border border-outline bg-surface-container-lowest dark:bg-on-background text-on-surface dark:text-inverse-on-surface font-body-sm text-body-sm focus:outline-none focus:border-primary transition-all\">\n<option>Internal (Agents Only)</option>\n<option>Public (Help Center)</option>\n<option>Draft</option>\n</select>\n</div>\n<div>\n<label class=\"font-label-md text-label-md text-on-surface-variant dark:text-outline block mb-1\">Category</label>\n<select class=\"w-full h-8 px-2 rounded border border-outline bg-surface-container-lowest dark:bg-on-background text-on-surface dark:text-inverse-on-surface font-body-sm text-body-sm focus:outline-none focus:border-primary transition-all\">\n<option>Network Connectivity</option>\n<option>Software Installation</option>\n<option>Hardware Issues</option>\n</select>\n</div>\n</div>\n</div>\n</aside>\n</div>\n</div>\n</main>\n<style>\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n    </style>" }}
    />
  );
}
