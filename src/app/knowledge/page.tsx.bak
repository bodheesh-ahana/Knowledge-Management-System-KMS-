condary placeholder-on-surface-variant dark:placeholder-outline\" placeholder=\"Search Knowledge Base (Cmd+K)...\" type=\"text\"/>\n<div class=\"px-2 py-0.5 rounded bg-surface-variant dark:bg-inverse-surface border border-outline-variant dark:border-outline text-on-surface-variant dark:text-outline font-mono text-[10px] uppercase ml-sm\">Cmd+K</div>\n</div>\n<!-- Trailing Actions -->\n<div class=\"flex items-center gap-md\">\n<button class=\"text-on-surface-variant dark:text-outline hover:text-primary dark:hover:text-primary-fixed-dim transition-colors\">\n<span class=\"material-symbols-outlined\">notifications</span>\n</button>\n<button class=\"text-on-surface-variant dark:text-outline hover:text-primary dark:hover:text-primary-fixed-dim transition-colors\">\n<span class=\"material-symbols-outlined\">contrast</span>\n</button>\n<button class=\"text-on-surface-variant dark:text-outline hover:text-primary dark:hover:text-primary-fixed-dim transition-colors\">\n<span class=\"material-symbols-outlined\">settings</span>\n</button>\n<div class=\"w-px h-6 bg-outline-variant dark:bg-outline mx-xs\"></div>\n<img alt=\"User Profile\" class=\"w-8 h-8 rounded-full border border-outline-variant object-cover\" data-alt=\"A small, professional headshot avatar of a corporate user with a neutral, well-lit expression, suitable for a dark-mode enterprise UI profile picture, showing only the head and shoulders against a very dark, subtle gradient background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuB6UG-Z1RU4msxemxidZQUUPFnYAeE2-Cr5e9hQCAMSVkJaiNPpxof4tTiHm7gGLVAk-vwRHc8rUp0yrJTHYooLO9vQJvFNNnjXVQJT_GiCGeZE7jsOTAz6E_pt7rYWe8P40rQDzaNb4EnT2lbd_GYylOvD7I2WzavXL9nHyAwr3tgvXZ-TXz2jDt4pgCeFZoArLYneFullmtHP57LVF3Tbce9J-a-Fi_uyCtabW07TCao9YtDnNOTPoiQqX4V9G1MIrRhT-hYQfc2p\"/>\n</div>\n</header>\n<!-- Page Content -->\n<div class=\"flex-1 p-lg md:p-xl max-w-container-max mx-auto w-full flex flex-col gap-lg\">\n<!-- Header & Robust Filters -->\n<section class=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-md\">\n<div class=\"space-y-xs\">\n<h2 class=\"font-h1 text-h1 text-on-surface dark:text-on-secondary\">Knowledge Base</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant dark:text-outline\">Browse, search, and manage enterprise documentation.</p>\n</div>\n<!-- View Controls -->\n<div class=\"flex items-center bg-surface-container-low dark:bg-[#152336] rounded-lg p-xs border border-outline-variant dark:border-outline\">\n<button class=\"p-xs rounded bg-surface dark:bg-[#283b54] text-primary dark:text-primary-fixed-dim shadow-sm transition-colors\" title=\"Card View\">\n<span class=\"material-symbols-outlined text-[20px]\">grid_view</span>\n</button>\n<button class=\"p-xs rounded text-on-surface-variant dark:text-outline hover:bg-surface-container-high dark:hover:bg-[#1a2b42] transition-colors\" title=\"Table View\">\n<span class=\"material-symbols-outlined text-[20px]\">table_rows</span>\n</button>\n<button class=\"p-xs rounded text-on-surface-variant dark:text-outline hover:bg-surface-container-high dark:hover:bg-[#1a2b42] transition-colors\" title=\"Compact View\">\n<span class=\"material-symbols-outlined text-[20px]\">view_list</span>\n</button>\n</div>\n</section>\n<!-- Filter Bar (Bento-ish horizontal scroll or wrap) -->\n<section class=\"flex flex-wrap items-center gap-sm\">\n<button class=\"flex items-center gap-xs px-sm py-xs rounded-full border border-outline-variant dark:border-outline bg-surface dark:bg-[#0b1c30] text-on-surface dark:text-on-secondary font-label-md text-label-md hover:bg-surface-container-high transition-colors\">\n<span class=\"material-symbols-outlined text-[16px]\">apps</span> App: All\n                    <span class=\"material-symbols-outlined text-[14px]\">arrow_drop_down</span>\n</button>\n<button class=\"flex items-center gap-xs px-sm py-xs rounded-full border border-outline-variant dark:border-outline bg-surface dark:bg-[#0b1c30] text-on-surface dark:text-on-secondary font-label-md text-label-md hover:bg-surface-container-high transition-colors\">\n<span class=\"material-symbols-outlined text-[16px]\">category</span> Category\n                    <span class=\"material-symbols-outlined text-[14px]\">arrow_drop_down</span>\n</button>\n<button class=\"flex items-center gap-xs px-sm py-xs rounded-full border border-outline-variant dark:border-outline bg-surface dark:bg-[#0b1c30] text-on-surface dark:text-on-secondary font-label-md text-label-md hover:bg-surface-container-high transition-colors\">\n<span class=\"material-symbols-outlined text-[16px]\">person</span> Owner\n                    <span class=\"material-symbols-outlined text-[14px]\">arrow_drop_down</span>\n</button>\n<button class=\"flex items-center gap-xs px-sm py-xs rounded-full border border-outline-variant dark:border-outline bg-surface dark:bg-[#0b1c30] text-on-surface dark:text-on-secondary font-label-md text-label-md hover:bg-surface-container-high transition-colors\">\n<span class=\"material-symbols-outlined text-[16px]\">sell</span> Tags\n                    <span class=\"material-symbols-outlined text-[14px]\">arrow_drop_down</span>\n</button>\n<button class=\"flex items-center gap-xs px-sm py-xs rounded-full border border-outline-variant dark:border-outline bg-surface dark:bg-[#0b1c30] text-on-surface dark:text-on-secondary font-label-md text-label-md hover:bg-surface-container-high transition-colors\">\n<span class=\"material-symbols-outlined text-[16px]\">published_with_changes</span> Status\n                    <span class=\"material-symbols-outlined text-[14px]\">arrow_drop_down</span>\n</button>\n<div class=\"flex-1\"></div>\n<button class=\"text-primary dark:text-primary-fixed-dim font-label-md text-label-md hover:underline flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[16px]\">filter_list_off</span> Clear Filters\n                </button>\n</section>\n<!-- Knowledge Grid (Glassmorphism/Card style) -->\n<section cla