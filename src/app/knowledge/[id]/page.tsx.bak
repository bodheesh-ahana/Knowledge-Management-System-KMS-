       </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded transition-all duration-200 ease-in-out text-on-surface-variant hover:bg-on-surface-variant/10\" href=\"#\">\n<span class=\"material-symbols-outlined\">track_changes</span>\n                Internal Tracker\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded transition-all duration-200 ease-in-out text-on-surface-variant hover:bg-on-surface-variant/10\" href=\"#\">\n<span class=\"material-symbols-outlined\">analytics</span>\n                Analytics\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded transition-all duration-200 ease-in-out text-on-surface-variant hover:bg-on-surface-variant/10\" href=\"#\">\n<span class=\"material-symbols-outlined\">description</span>\n                Documents\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded transition-all duration-200 ease-in-out text-on-surface-variant hover:bg-on-surface-variant/10\" href=\"#\">\n<span class=\"material-symbols-outlined\">notifications</span>\n                Notifications\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded transition-all duration-200 ease-in-out text-on-surface-variant hover:bg-on-surface-variant/10\" href=\"#\">\n<span class=\"material-symbols-outlined\">group</span>\n                Users\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded transition-all duration-200 ease-in-out text-on-surface-variant hover:bg-on-surface-variant/10\" href=\"#\">\n<span class=\"material-symbols-outlined\">settings</span>\n                Settings\n            </a>\n</nav>\n<div class=\"mt-auto pt-lg border-t border-outline\">\n<p class=\"px-md mb-sm font-label-md text-label-md text-outline uppercase tracking-wider\">Quick Links</p>\n<a class=\"flex items-center gap-md px-md py-sm rounded text-on-surface-variant hover:bg-on-surface-variant/10 font-body-sm text-body-sm\" href=\"#\">\n<span class=\"material-symbols-outlined text-[16px]\">widgets</span> Applications\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded text-on-surface-variant hover:bg-on-surface-variant/10 font-body-sm text-body-sm\" href=\"#\">\n<span class=\"material-symbols-outlined text-[16px]\">star</span> Favourite Articles\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded text-on-surface-variant hover:bg-on-surface-variant/10 font-body-sm text-body-sm\" href=\"#\">\n<span class=\"material-symbols-outlined text-[16px]\">drafts</span> Drafts\n            </a>\n<a class=\"flex items-center gap-md px-md py-sm rounded text-on-surface-variant hover:bg-on-surface-variant/10 font-body-sm text-body-sm\" href=\"#\">\n<span class=\"material-symbols-outlined text-[16px]\">history</span> Recent Entries\n            </a>\n</div>\n</aside>\n<!-- Main Content Wrapper -->\n<div class=\"flex-1 flex flex-col md:ml-sidebar-width overflow-hidden\">\n<!-- TopNavBar -->\n<header class=\"sticky top-0 z-40 w-full h-14 bg-surface-dim border-b border-outline flex justify-between items-center px-lg\">\n<div class=\"flex items-center gap-md w-1/3\">\n<div class=\"relative w-full max-w-md\">\n<span class=\"material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-outline text-[18px]\">search</span>\n<input class=\"w-full bg-surface text-on-surface border border-outline rounded pl-xl pr-sm py-xs font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent\" placeholder=\"Search knowledge base...\" type=\"text\"/>\n</div>\n</div>\n<div class=\"flex items-center gap-sm\">\n<button class=\"p-xs text-on-surface-variant hover:text-primary-fixed-dim transition-colors duration-150\">\n<span class=\"material-symbols-outlined\">notifications</span>\n</button>\n<button class=\"p-xs text-on-surface-variant hover:text-primary-fixed-dim transition-colors duration-150\">\n<span class=\"material-symbols-outlined\">contrast</span>\n</button>\n<button class=\"p-xs text-on-surface-variant hover:text-primary-fixed-dim transition-colors duration-150\">\n<span class=\"material-symbols-outlined\">settings</span>\n</button>\n<button class=\"ml-sm flex items-center gap-xs px-sm py-xs bg-secondary/20 hover:bg-secondary/30 rounded text-on-surface font-label-md text-label-md transition-colors duration-150 border border-outline-variant\">\n<span class=\"material-symbols-outlined text-[14px]\">keyboard_command_key</span> K\n                </button>\n<img alt=\"User Profile\" class=\"w-8 h-8 rounded-full border border-outline object-cover ml-md\" data-alt=\"A small, circular avatar portrait of a professional corporate user in a modern office setting. The lighting is soft and neutral, conveying a sense of corporate professionalism. The subject is slightly out of focus, typical of UI profile placeholders, with a dark slate background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuB_dZRGoVCt7n5DFubfaULVe9QjlJX8mW00CberDiOnkebUpJ_Hc9v6_MmbKLuPs_1ts-LtHrWprPIK20CGZX1dljyU3OoRbc-7APFb0Q8lUWIf_oLNCNvaLYQ2PA7NPGQesxluW-7qG0huSamkhcbW0WNBYFZ66ZB8dqVre-6SIhd3X8mA9yG_e11im6LuxYIXQ66-GSza4er7N4HI5gNuPXmUv9NeMyHqsQaixUsPrUhwaB-nq1pImL36pzhU_JE4YA1csdCl1lTE\"/>\n</div>\n</header>\n<!-- Canvas Area -->\n<main class=\"flex-1 overflow-y-auto p-lg md:p-2xl flex justify-center bg-surface-bright\">\n<div class=\"w-full max-w-[1000px] flex gap-2xl\">\n<!-- Article Content -->\n<article class=\"flex-1 max-w-[720px]\">\n<!-- Breadcrumbs & Meta -->\n<nav class=\"flex items-center gap-xs text-outline font-body-sm text-body-sm mb-lg\">\n<a class=\"hover:text-primary transition-colors\" href=\"#\">Knowledge Base</a>\n<span class=\"material-symbols-outlined text-[14px]\">chevron_right</span>\n<a class=\"hover:text-primary transition-colors\" href=\"#\">Infrastructure</a>\n<span class=\"material-symbols-outlined text-[14px]\">chevron_right</span>\n<span class=\"text-on-surface\">Database Connections</span>\n</nav>\n<h1 class=\"font-h1 text-h1 text-on-background mb-md\">Resolving PostreSQL Connection Pool Exhaustion in Production</h1>\n<div class=\"flex flex-wrap items-center gap-lg border-b border-outline-variant pb-md mb-xl text-outline font-body-sm text-body-sm\">\n<div class=\"flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[16px]\">person</span>\n<span>Sarah Jenkins</span>\n</div>\n<div class=\"flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[16px]\">calendar_today</span>\n<span>Updated Oct 24, 2023</span>\n</div>\n<div class=\"flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[16px]\">visibility</span>\n<span>1.2k Views</span>\n</div>\n<div class=\"flex items-center gap-xs ml-auto\">\n<span class=\"px-sm py-xs bg-secondary-container text-on-secondary-container rounded font-label-md text-label-md\">High Priority</span>\n</div>\n</div>\n<!-- Sections -->\n<div class=\"space-y-xl\">\n<section id=\"issue-summary\">\n<h3 class=\"font-h3 text-h3 text-on-background mb-sm border-b border-outline-variant pb-xs\">Issue Summary</h3>\n<p class=\"text-on-surface-variant font-body-lg text-body-lg\">\n                                Applications experience intermittent 500 Internal Server Errors accompanied by increased latency. The application logs indicate `FATAL: sorry, too many clients already` when attempting to connect to the primary PostgreSQL cluster.\n                            </p>\n</section>\n<section id=\"environment\">\n<h3 class=\"font-h3 text-h3 text-on-background mb-sm border-b border-outline-variant pb-xs\">Environment</h3>\n<ul class=\"list-disc list-inside text-on-surface-variant space-y-xs ml-sm font-body-md text-body-md\">\n<li>PostgreSQL 14.x (Primary cluster)</li>\n<li>PgBouncer (Transaction pooling mode)</li>\n<li>Node.js / Express microservices</li>\n<li>AWS RDS infrastructure</li>\n</ul>\n</section>\n<section id=\"troubleshooting\">\n<h3 class=\"font-h3 text-h3 text-on-background mb-sm border-b border-outline-variant pb-xs\">Troubleshooting Steps</h3>\n<div class=\"bg-surface border border-outline rounded p-md font-mono text-mono text-on-surface overflow-x-auto mb-md\">\n                                # Check current active connections<br/>\n                                SELECT count(*), state FROM pg_stat_activity GROUP BY state;<br/><br/>\n                                # Verify max_connections setting<br/>\n                                SHOW max_connections;\n                            </div>\n<p class=\"text-on-surface-variant font-body-md text-body-md mb-sm\">\n                                If the active connections approach `max_connections`, verify PgBouncer configuration. Ensure applications are correctly releasing connections back to the pool after transactions complete.\n                            </p>\n</section>\n</div>\n</article>\n<!-- Right Sidebar (Sticky TOC & Meta) -->\n<aside class=\"hidden xl:block w-[240px] shrink-0 sticky top-lg self-start space-y-xl\">\n<!-- Actions -->\n<div class=\"flex gap-sm\">\n<button class=\"flex-1 flex items-center justify-center gap-xs py-sm border border-outline rounded text-on-surface hover:bg-surface-container-high transition-colors font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[16px]\">bookmark</span> Save\n                        </button>\n<button class=\"flex-1 flex items-center justify-center gap-xs py-sm border border-outline rounded text-on-surface hover:bg-surface-container-high transition-colors font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[16px]\">share</span> Share\n                        </button>\n</div>\n<!-- TOC -->\n<div>\n<h4 class=\"font-label-md text-label-md text-outline uppercase tracking-wider mb-sm\">Contents</h4>\n<nav class=\"space-y-sm font-body-sm text-body-sm\">\n<a class=\"block text-primary hover:underline\" href=\"#issue-summary\">Issue Summary</a>\n<a class=\"block text-on-surface-variant hover:text-primary\" href=\"#environment\">Environment</a>\n<a class=\"block text-on-surface-variant hover:text-primary\" href=\"#troubleshooting\">Troubleshooting Steps</a>\n<a class=\"block text-on-surface-variant hover:text-primary\" href=\"#resolution\">Resolution</a>\n</nav>\n</div>\n</aside>\n</div>\n</main>\n</div>" }}
    />
