export default function ApplicationDetailsPage() {
  return (
    <div className="font-body-md text-body-md antialiased h-screen overflow-hidden flex flex-col md:flex-row dark"
      dangerouslySetInnerHTML={{ __html: "<!-- Mobile Top Navigation (Visible only on mobile md:hidden) - Using BottomNavBar pattern as per instructions but adapted for details page suppression -->\n<!-- Suppressed navigation shell on mobile for this specific task-focused 'Details' screen to prioritize Canvas -->\n<!-- Desktop Side Navigation -->\n<aside class=\"hidden md:flex flex-col h-full py-lg px-md bg-surface-container-lowest border-r border-outline transition-all duration-200 ease-in-out fixed left-0 top-0 h-screen w-sidebar-width z-30\">\n<!-- Header -->\n<div class=\"flex items-center gap-sm mb-xl\">\n<div class=\"w-8 h-8 rounded bg-primary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-primary text-[20px]\" data-icon=\"hub\">hub</span>\n</div>\n<div>\n<h1 class=\"font-h2 text-h2 font-bold text-primary-fixed-dim\">KMS</h1>\n<p class=\"font-label-md text-label-md text-outline\">Enterprise Support</p>\n</div>\n</div>\n<!-- CTA -->\n<button class=\"w-full flex items-center justify-center gap-xs py-2 px-4 bg-primary text-on-primary rounded font-label-md text-label-md font-semibold hover:bg-primary-fixed-dim hover:text-on-primary-fixed transition-colors mb-xl shadow-[0_1px_2px_rgba(0,0,0,0.3)]\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"add\">add</span>\n            Quick Add\n        </button>\n<!-- Main Nav -->\n<nav class=\"flex-1 overflow-y-auto\">\n<ul class=\"space-y-1\">\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"dashboard\">dashboard</span>\n                        Dashboard\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"auto_stories\">auto_stories</span>\n                        Knowledge Base\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"confirmation_number\">confirmation_number</span>\n                        Tickets\n                    </a>\n</li>\n<!-- Active Item -->\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded bg-secondary-container text-on-secondary-container border-l-2 border-primary transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"apps\" style=\"font-variation-settings: 'FILL' 1;\">apps</span>\n                        Applications\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"track_changes\">track_changes</span>\n                        Internal Tracker\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"analytics\">analytics</span>\n                        Analytics\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"description\">description</span>\n                        Documents\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n                        Notifications\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"group\">group</span>\n                        Users\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"settings\">settings</span>\n                        Settings\n                    </a>\n</li>\n</ul>\n<div class=\"mt-lg pt-lg border-t border-outline\">\n<p class=\"font-label-md text-label-md text-outline px-3 mb-sm uppercase\">Quick Links</p>\n<ul class=\"space-y-1\">\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"widgets\">widgets</span>\n                            Applications\n                        </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"star\">star</span>\n                            Favourite Articles\n                        </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"drafts\">drafts</span>\n                            Drafts\n                        </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-3 py-2 rounded text-on-surface-variant hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-body-md text-body-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"history\">history</span>\n                            Recent Entries\n                        </a>\n</li>\n</ul>\n</div>\n</nav>\n</aside>\n<!-- Main Content Wrapper -->\n<div class=\"flex-1 flex flex-col md:ml-[260px] h-full overflow-hidden relative bg-[#131b2e]\">\n<!-- Top App Bar -->\n<header class=\"flex justify-between items-center px-lg w-full sticky top-0 z-20 w-full h-14 bg-surface-dim border-b border-outline transition-colors duration-150 shrink-0 shadow-sm\">\n<div class=\"flex items-center gap-md\">\n<!-- Breadcrumb / Back -->\n<button class=\"md:hidden text-outline hover:text-primary-fixed-dim p-1 rounded-full hover:bg-on-surface-variant transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"arrow_back\">arrow_back</span>\n</button>\n<div class=\"hidden md:flex items-center text-outline font-body-sm text-body-sm\">\n<a class=\"hover:text-primary-fixed-dim transition-colors\" href=\"#\">Applications</a>\n<span class=\"material-symbols-outlined text-[16px] mx-1\" data-icon=\"chevron_right\">chevron_right</span>\n<span class=\"text-on-surface\">Finance Sync</span>\n</div>\n</div>\n<!-- Trailing Actions -->\n<div class=\"flex items-center gap-md\">\n<div class=\"relative hidden md:block\">\n<span class=\"material-symbols-outlined absolute left-2 top-1.5 text-[16px] text-outline\" data-icon=\"search\">search</span>\n<input class=\"bg-[#283044] border border-outline rounded text-body-sm text-on-surface pl-8 pr-2 py-1 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary w-64 placeholder-outline\" placeholder=\"Search Finance Sync...\" type=\"text\"/>\n<div class=\"absolute right-2 top-1.5 flex items-center gap-1\">\n<kbd class=\"font-mono text-[10px] text-outline bg-[#131b2e] px-1 rounded border border-outline border-opacity-50\">Cmd+K</kbd>\n</div>\n</div>\n<div class=\"flex items-center gap-sm border-l border-outline pl-md ml-sm\">\n<button class=\"text-outline hover:text-primary-fixed-dim p-1 rounded hover:bg-on-surface-variant transition-colors relative\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n<span class=\"absolute top-1 right-1 w-2 h-2 bg-error rounded-full\"></span>\n</button>\n<button class=\"text-outline hover:text-primary-fixed-dim p-1 rounded hover:bg-on-surface-variant transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"contrast\">contrast</span>\n</button>\n<button class=\"text-outline hover:text-primary-fixed-dim p-1 rounded hover:bg-on-surface-variant transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"settings\">settings</span>\n</button>\n<div class=\"w-8 h-8 rounded-full bg-tertiary-container overflow-hidden ml-sm border border-outline cursor-pointer shrink-0\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDXksvzncrGP1eTOgnqPR2Hz9XXmD7LXgNDvgBTn5aKJi90czC1zATVSvWk7z_a2tCJ_0e7o2lt8p7tPqfMRaYU-uirOwid_rj74OL3emN9n1k1bXWzw_FE0-AEXRIMdz2QroVVVYing-dyjcFHKi3twbmcAlm7zXnEPLBQMDXWbjeSxnqTeIAEOTihu6FdWLS5IiZlnExpklG_-HGAgo3PocjLqWAxVPefsNz1xgT5PHhpO2k7E2RvoaSDV-O6HSFZCXn-Upo0ooWR\"/>\n</div>\n</div>\n</div>\n</header>\n<!-- Main Scrollable Area -->\n<main class=\"flex-1 overflow-y-auto p-md lg:p-lg\">\n<div class=\"max-w-[1200px] mx-auto w-full grid grid-cols-1 xl:grid-cols-12 gap-lg\">\n<!-- Center Canvas (Details) -->\n<div class=\"xl:col-span-8 flex flex-col gap-lg\">\n<!-- App Header Card -->\n<div class=\"bg-[#1c253c] border border-outline-variant rounded-lg p-lg shadow-sm\">\n<div class=\"flex flex-col sm:flex-row sm:items-start justify-between gap-md\">\n<div class=\"flex items-start gap-lg\">\n<div class=\"w-16 h-16 rounded-xl bg-primary-container bg-opacity-20 flex items-center justify-center shrink-0 border border-primary border-opacity-30\">\n<span class=\"material-symbols-outlined text-[32px] text-inverse-primary\" data-icon=\"sync_alt\">sync_alt</span>\n</div>\n<div>\n<div class=\"flex items-center gap-sm mb-1\">\n<h1 class=\"font-h1 text-h1 text-[#ffffff]\">Finance Sync</h1>\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide uppercase bg-emerald-900 text-emerald-200 border border-emerald-700\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></span> Healthy\n                                        </span>\n</div>\n<p class=\"font-body-md text-body-md text-tertiary-fixed-dim max-w-xl\">\n                                        Core microservice responsible for real-time synchronization of ledger entries between regional ERP systems and the central data warehouse.\n                                    </p>\n</div>\n</div>\n<div class=\"flex sm:flex-col gap-sm sm:items-end shrink-0\">\n<button class=\"flex items-center gap-xs px-3 py-1.5 bg-[#283044] hover:bg-[#38485d] border border-outline rounded text-on-surface font-label-md text-label-md transition-colors\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"edit\">edit</span>\n                                    Edit Details\n                                </button>\n<button class=\"flex items-center gap-xs px-3 py-1.5 bg-[#283044] hover:bg-[#38485d] border border-outline rounded text-on-surface font-label-md text-label-md transition-colors\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"open_in_new\">open_in_new</span>\n                                    View Logs\n                                </button>\n</div>\n</div>\n<div class=\"mt-lg grid grid-cols-2 sm:grid-cols-4 gap-md pt-md border-t border-outline-variant\">\n<div>\n<p class=\"font-label-md text-label-md text-outline mb-1\">App ID</p>\n<p class=\"font-mono text-mono text-[#ffffff]\">APP-9283</p>\n</div>\n<div>\n<p class=\"font-label-md text-label-md text-outline mb-1\">Owner Team</p>\n<div class=\"flex items-center gap-xs text-[#ffffff]\">\n<span class=\"material-symbols-outlined text-[16px] text-outline\" data-icon=\"group\">group</span>\n<span class=\"font-body-sm text-body-sm\">FinEng Alpha</span>\n</div>\n</div>\n<div>\n<p class=\"font-label-md text-label-md text-outline mb-1\">Tier</p>\n<p class=\"font-body-sm text-body-sm text-[#ffffff]\">Tier 1 (Mission Critical)</p>\n</div>\n<div>\n<p class=\"font-label-md text-label-md text-outline mb-1\">Last Deployed</p>\n<p class=\"font-body-sm text-body-sm text-[#ffffff]\">2 hours ago (v4.2.1)</p>\n</div>\n</div>\n</div>\n<!-- Tabs -->\n<div class=\"border-b border-outline\">\n<nav aria-label=\"Tabs\" class=\"flex gap-lg\">\n<a class=\"border-b-2 border-primary text-primary-fixed-dim font-label-md text-label-md py-3 px-1 whitespace-nowrap\" href=\"#\">\n                                Overview\n                            </a>\n<a class=\"border-b-2 border-transparent text-outline hover:text-tertiary-fixed-dim hover:border-outline-variant font-label-md text-label-md py-3 px-1 whitespace-nowrap transition-colors\" href=\"#\">\n                                Knowledge Base\n                            </a>\n<a class=\"border-b-2 border-transparent text-outline hover:text-tertiary-fixed-dim hover:border-outline-variant font-label-md text-label-md py-3 px-1 whitespace-nowrap transition-colors flex items-center gap-2\" href=\"#\">\n                                Known Issues <span class=\"bg-[#283044] text-outline px-1.5 py-0.5 rounded text-[10px]\">3</span>\n</a>\n<a class=\"border-b-2 border-transparent text-outline hover:text-tertiary-fixed-dim hover:border-outline-variant font-label-md text-label-md py-3 px-1 whitespace-nowrap transition-colors\" href=\"#\">\n                                Servers\n                            </a>\n</nav>\n</div>\n<!-- Tab Content: Overview -->\n<div class=\"grid grid-cols-1 gap-lg\">\n<!-- Bento Grid style metrics -->\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-md\">\n<div class=\"bg-[#1c253c] border border-outline-variant rounded-lg p-md shadow-sm relative overflow-hidden\">\n<div class=\"absolute -right-4 -top-4 w-24 h-24 bg-primary rounded-full opacity-5 blur-xl\"></div>\n<p class=\"font-label-md text-label-md text-outline mb-2 flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"speed\">speed</span> Avg Latency\n                                </p>\n<p class=\"font-h2 text-h2 text-[#ffffff]\">42<span class=\"text-body-sm font-normal text-outline ml-1\">ms</span></p>\n<div class=\"mt-2 h-1 w-full bg-[#283044] rounded-full overflow-hidden\">\n<div class=\"h-full bg-emerald-500 w-1/4 rounded-full\"></div>\n</div>\n</div>\n<div class=\"bg-[#1c253c] border border-outline-variant rounded-lg p-md shadow-sm relative overflow-hidden\">\n<div class=\"absolute -right-4 -top-4 w-24 h-24 bg-error rounded-full opacity-5 blur-xl\"></div>\n<p class=\"font-label-md text-label-md text-outline mb-2 flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"error\">error</span> Error Rate\n                                </p>\n<p class=\"font-h2 text-h2 text-[#ffffff]\">0.02<span class=\"text-body-sm font-normal text-outline ml-1\">%</span></p>\n<p class=\"font-body-sm text-[11px] text-outline mt-1\">+0.01% from yesterday</p>\n</div>\n<div class=\"bg-[#1c253c] border border-outline-variant rounded-lg p-md shadow-sm relative overflow-hidden\">\n<div class=\"absolute -right-4 -top-4 w-24 h-24 bg-tertiary-fixed rounded-full opacity-5 blur-xl\"></div>\n<p class=\"font-label-md text-label-md text-outline mb-2 flex items-center gap-xs\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"memory\">memory</span> CPU Utilization\n                                </p>\n<p class=\"font-h2 text-h2 text-[#ffffff]\">68<span class=\"text-body-sm font-normal text-outline ml-1\">%</span></p>\n<div class=\"mt-2 h-1 w-full bg-[#283044] rounded-full overflow-hidden\">\n<div class=\"h-full bg-amber-500 w-[68%] rounded-full\"></div>\n</div>\n</div>\n</div>\n<!-- Architecture & Dependencies -->\n<div class=\"grid grid-cols-1 lg:grid-cols-2 gap-md\">\n<!-- Architecture Summary -->\n<div class=\"bg-[#1c253c] border border-outline-variant rounded-lg p-md shadow-sm flex flex-col\">\n<h3 class=\"font-h3 text-h3 text-[#ffffff] mb-md flex items-center gap-sm\">\n<span class=\"material-symbols-outlined text-outline\" data-icon=\"account_tree\">account_tree</span>\n                                    Architecture Summary\n                                </h3>\n<div class=\"prose prose-invert prose-sm max-w-none font-body-sm text-tertiary-fixed-dim\">\n<p>Finance Sync is built on a containerized Node.js runtime, orchestrating message queues via RabbitMQ. It utilizes Redis for caching frequently accessed ledger hashes and persists state in a partitioned PostgreSQL cluster.</p>\n<ul class=\"list-disc pl-4 mt-2 space-y-1\">\n<li><strong>Framework:</strong> Express.js / TypeScript</li>\n<li><strong>Messaging:</strong> RabbitMQ (Topic Exchange)</li>\n<li><strong>Data Store:</strong> PostgreSQL 14, Redis 7</li>\n</ul>\n</div>\n<div class=\"mt-auto pt-md text-right\">\n<a class=\"text-primary-fixed-dim hover:text-inverse-primary font-label-md text-label-md text-[11px] uppercase tracking-wider inline-flex items-center gap-xs\" href=\"#\">\n                                        View Full Topology <span class=\"material-symbols-outlined text-[14px]\" data-icon=\"arrow_forward\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Dependencies (Glassmorphism inspired list) -->\n<div class=\"bg-[#1c253c] border border-outline-variant rounded-lg p-md shadow-sm\">\n<h3 class=\"font-h3 text-h3 text-[#ffffff] mb-md flex items-center gap-sm\">\n<span class=\"material-symbols-outlined text-outline\" data-icon=\"link\">link</span>\n                                    Key Dependencies\n                                </h3>\n<div class=\"space-y-2\">\n<div class=\"flex items-center justify-between p-2 rounded bg-[#283044] bg-opacity-50 border border-outline-variant border-opacity-30 hover:bg-opacity-80 transition-colors\">\n<div class=\"flex items-center gap-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary-fixed\" data-icon=\"database\">database</span>\n<div>\n<p class=\"font-body-sm text-[13px] text-[#ffffff] font-medium\">Core Ledger DB</p>\n<p class=\"text-[11px] text-outline\">PostgreSQL</p>\n</div>\n</div>\n<span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n</div>\n<div class=\"flex items-center justify-between p-2 rounded bg-[#283044] bg-opacity-50 border border-outline-variant border-opacity-30 hover:bg-opacity-80 transition-colors\">\n<div class=\"flex items-center gap-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary-fixed\" data-icon=\"api\">api</span>\n<div>\n<p class=\"font-body-sm text-[13px] text-[#ffffff] font-medium\">Auth Gateway v2</p>\n<p class=\"text-[11px] text-outline\">Internal API</p>\n</div>\n</div>\n<span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n</div>\n<div class=\"flex items-center justify-between p-2 rounded bg-[#283044] bg-opacity-50 border border-outline-variant border-opacity-30 hover:bg-opacity-80 transition-colors\">\n<div class=\"flex items-center gap-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary-