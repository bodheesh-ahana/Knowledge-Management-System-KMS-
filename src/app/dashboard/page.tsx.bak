utline/20\">\n<p class=\"px-sm font-label-md text-label-md text-on-surface-variant opacity-70 mb-sm\">PINNED</p>\n<ul class=\"flex flex-col gap-xs space-y-1\">\n<li>\n<a class=\"flex items-center gap-md px-sm py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-label-md text-label-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"widgets\">widgets</span>\n                            Applications\n                        </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-sm py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-label-md text-label-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"star\">star</span>\n                            Favourite Articles\n                        </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-sm py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-label-md text-label-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"drafts\">drafts</span>\n                            Drafts\n                        </a>\n</li>\n</ul>\n</div>\n</div>\n<div class=\"mt-auto pt-lg border-t border-outline-variant dark:border-outline/20 flex flex-col gap-sm\">\n<button class=\"w-full flex items-center justify-center gap-2 bg-primary text-on-primary py-2 px-4 rounded-lg font-label-md text-label-md shadow hover:bg-primary-fixed-variant transition-colors\">\n<span class=\"material-symbols-outlined text-[18px]\">add</span>\n                Quick Add\n            </button>\n<ul class=\"flex flex-col gap-xs space-y-1 mt-sm\">\n<li>\n<a class=\"flex items-center gap-md px-sm py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-label-md text-label-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n                        Notifications\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-sm py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-label-md text-label-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"group\">group</span>\n                        Users\n                    </a>\n</li>\n<li>\n<a class=\"flex items-center gap-md px-sm py-2 rounded text-on-surface-variant dark:text-on-surface-variant hover:bg-surface-container-high dark:hover:bg-on-surface-variant transition-all duration-200 ease-in-out font-label-md text-label-md\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"settings\">settings</span>\n                        Settings\n                    </a>\n</li>\n</ul>\n</div>\n</nav>\n<!-- Main Content Area -->\n<main class=\"ml-sidebar-width flex-1 flex flex-col min-w-0\">\n<!-- TopNavBar -->\n<header class=\"sticky top-0 z-40 w-full h-14 bg-surface dark:bg-surface-dim border-b border-outline-variant dark:border-outline flex justify-between items-center px-lg transition-colors duration-150 shadow-sm\">\n<div class=\"flex items-center flex-1 max-w-md relative group\">\n<span class=\"material-symbols-outlined absolute left-3 text-on-surface-variant opacity-70 group-focus-within:text-primary transition-colors text-[20px]\">search</span>\n<input class=\"w-full bg-surface-container-highest dark:bg-[#1f222c] border border-outline-variant/30 rounded-lg pl-10 pr-4 py-1.5 font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all\" placeholder=\"Search knowledge base, tickets...\" type=\"text\"/>\n<div class=\"absolute right-3 px-1.5 py-0.5 rounded border border-outline-variant/50 text-[10px] font-mono text-on-surface-variant bg-surface opacity-80\">Cmd+K</div>\n</div>\n<div class=\"flex items-center gap-sm ml-auto\">\n<button class=\"w-8 h-8 flex items-center justify-center rounded hover:bg-surface-container-high text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed-dim transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n</button>\n<button class=\"w-8 h-8 flex items-center justify-center rounded hover:bg-surface-container-high text-on-surface-variant hover:text-primary dark:hover:text-primary-fixed-dim transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"contrast\">contrast</span>\n</button>\n<div class=\"w-px h-6 bg-outline-variant/30 mx-2\"></div>\n<button class=\"flex items-center gap-2 ml-1 p-1 pr-2 rounded-full border border-outline-variant/30 hover:border-outline transition-colors bg-surface-container-low\">\n<img class=\"w-6 h-6 rounded-full object-cover bg-outline\" data-alt=\"A small, professional portrait photograph of a young corporate executive, neutral background, sharp focus, professional attire, soft studio lighting.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDUHCfDxd5xK2pPP4YSuc8JUFWHAZTtuWKqEljxLC-lRERATfjgg46Dwtse_kX4WRg7B3gqBN-UNn8Jxq1o3CvUH9w1raMUCbI4yf3xflaFZEM_tecI8xZBIMSeaFyZQv2ZFXjhn_bcr6JR4ahng6mTljMi5iAWI8oEygQILEIlUzV3HJExBz8ZgyK_X9ay4DoXkldRt1UHepiZcVOf4BolLL7gwclZc2n8Nnn0pdxidG-_BOwPrywpW8tJQyQMNA5bOcaOVgnUzM7w\"/>\n<span class=\"font-label-md text-label-md text-on-surface\">Alex R.</span>\n<span class=\"material-symbols-outlined text-[16px] text-on-surface-variant\">expand_more</span>\n</button>\n</div>\n</header>\n<!-- Dashboard Canvas -->\n<div class=\"flex-1 p-lg overflow-y-auto bg-background/50\">\n<div class=\"max-w-[1600px] mx-auto space-y-lg\">\n<!-- Welcome Header -->\n<div class=\"flex justify-between items-end pb-sm border-b border-outline-variant/20\">\n<div>\n<h1 class=\"font-h1 text-h1 text-on-surface tracking-tight\">Executive Dashboard</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant mt-1 flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[16px]\">calendar_today</span>\n                            Wednesday, October 25, 2023\n                        </p>\n</div>\n<div class=\"flex gap-3\">\n<button class=\"px-4 py-2 rounded-lg border border-outline-variant text-on-surface font-label-md text-label-md hover:bg-surface-container-highest transition-colors flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px]\">download</span>\n                            Export Report\n                        </button>\n</div>\n</div>\n<!-- Top Stats Grid -->\n<div class=\"grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-md\">\n<!-- Stat Card 1 -->\n<div class=\"glass-panel rounded-xl p-md flex flex-col relative overflow-hidden group\">\n<div class=\"absolute top-0 left-0 w-full h-1 bg-error opacity-80\"></div>\n<div class=\"flex justify-between items-start mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Open Tickets</span>\n<span class=\"material-symbols-outlined text-[20px] text-error\">confirmation_number</span>\n</div>\n<div class=\"flex items-end gap-2 mt-auto\">\n<span class=\"font-h1 text-h1 font-bold text-on-surface leading-none\">142</span>\n<span class=\"font-body-sm text-body-sm text-error bg-error-container/30 px-1.5 py-0.5 rounded flex items-center mb-1\">\n<span class=\"material-symbols-outlined text-[14px]\">trending_up</span> 12%\n                            </span>\n</div>\n</div>\n<!-- Stat Card 2 -->\n<div class=\"glass-panel rounded-xl p-md flex flex-col relative overflow-hidden group\">\n<div class=\"absolute top-0 left-0 w-full h-1 bg-primary opacity-80\"></div>\n<div class=\"flex justify-between items-start mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">KB Articles</span>\n<span class=\"material-symbols-outlined text-[20px] text-primary\">auto_stories</span>\n</div>\n<div class=\"flex items-end gap-2 mt-auto\">\n<span class=\"font-h1 text-h1 font-bold text-on-surface leading-none\">8,405</span>\n<span class=\"font-body-sm text-body-sm text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-900/30 px-1.5 py-0.5 rounded flex items-center mb-1\">\n<span class=\"material-symbols-outlined text-[14px]\">trending_up</span> 4%\n                            </span>\n</div>\n</div>\n<!-- Stat Card 3 -->\n<div class=\"glass-panel rounded-xl p-md flex flex-col relative overflow-hidden group\">\n<div class=\"absolute top-0 left-0 w-full h-1 bg-amber-500 opacity-80\"></div>\n<div class=\"flex justify-between items-start mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Pending Reviews</span>\n<span class=\"material-symbols-outlined text-[20px] text-amber-500\">pending_actions</span>\n</div>\n<div class=\"flex items-end gap-2 mt-auto\">\n<span class=\"font-h1 text-h1 font-bold text-on-surface leading-none\">38</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mb-1\">Items</span>\n</div>\n</div>\n<!-- Stat Card 4 -->\n<div class=\"glass-panel rounded-xl p-md flex flex-col relative overflow-hidden group\">\n<div class=\"absolute top-0 left-0 w-full h-1 bg-indigo-500 opacity-80\"></div>\n<div class=\"flex justify-between items-start mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Apps Supported</span>\n<span class=\"material-symbols-outlined text-[20px] text-indigo-500\">apps</span>\n</div>\n<div class=\"flex items-end gap-2 mt-auto\">\n<span class=\"font-h1 text-h1 font-bold text-on-surface leading-none\">124</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant mb-1\">Active</span>\n</div>\n</div>\n<!-- Stat Card 5 -->\n<div class=\"glass-panel rounded-xl p-md flex flex-col relative overflow-hidden group\">\n<div class=\"absolute top-0 left-0 w-full h-1 bg-emerald-500 opacity-80\"></div>\n<div class=\"flex justify-between items-start mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">Avg Res. Time</span>\n<span class=\"material-symbols-outlined text-[20px] text-emerald-500\">timer</span>\n</div>\n<div class=\"flex items-end gap-2 mt-auto\">\n<span class=\"font-h1 text-h1 font-bold text-on-surface leading-none\">2.4</span>\n<span class=\"font-body-sm text-body-sm text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-900/30 px-1.5 py-0.5 rounded flex items-center mb-1\">\n<span class=\"material-symbols-outlined text-[14px]\">trending_down</span> 0.5h\n                            </span>\n</div>\n</div>\n<!-- Stat Card 6 -->\n<div class=\"glass-panel rounded-xl p-md flex flex-col relative overflow-hidden group\">\n<div class=\"absolute top-0 left-0 w-full h-1 bg-cyan-500 opacity-80\"></div>\n<div class=\"flex justify-between items-start mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface-variant uppercase tracking-wider\">KB Reuse Rate</span>\n<span class=\"material-symbols-outlined text-[20px] text-cyan-500\">recycling</span>\n</div>\n<div class=\"flex items-end gap-2 mt-auto\">\n<span class=\"font-h1 text-h1 font-bold text-on-surface leading-none\">78%</span>\n<span class=\"font-body-sm text-body-sm text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-900/30 px-1.5 py-0.5 rounded flex items-center mb-1\">\n<span class=\"material-symbols-outlined text-[14px]\">trending_up</span> 2%\n                            </span>\n</div>\n</div>\n</div>\n<!-- Bento Grid Layout for Complex Content -->\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-lg\">\n<!-- Left Column (Large) -->\n<div class=\"lg:col-span-8 flex flex-col gap-lg\">\n<!-- Chart: Knowledge Growth -->\n<div class=\"glass-panel rounded-xl p-lg flex flex-col border border-outline-variant/30 shadow-sm\">\n<div class=\"flex justify-between items-center mb-md\">\n<h3 class=\"font-h3 text-h3 font-semibold text-on-surface\">Knowledge Asset Growth</h3>\n<div class=\"flex gap-2\">\n<button class=\"px-2 py-1 text-[11px] font-mono rounded bg-surface-container-high text-on-surface-variant\">1W</button>\n<button class=\"px-2 py-1 text-[11px] font-mono rounded bg-primary text-on-primary\">1M</button>\n<button class=\"px-2 py-1 text-[11px] font-mono rounded bg-surface-container-high text-on-surface-variant\">1Y</button>\n</div>\n</div>\n<div class=\"w-full h-[280px] bg-cover bg-center rounded-lg border border-outline-variant/10\" data-alt=\"A clean, minimalist UI data visualization line chart showing steady upward growth in a corporate dashboard setting. The chart uses a soft blue primary color line with a subtle gradient fill below it, set against a pristine, dark-themed background. The axes are minimal with light gray text, conveying an analytical, professional, and precise aesthetic.\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuA54tB5LXeWjAV3mNfpyitPeCaDFF7v2jBfqhDT4sM8Wc1pNTQ6ot6mOG8TOP_wrlNGUajyLpZgDCxFDHlXBpGC78AXytDbS3Mu_kOz5eHlXDpd7jSrBOsZyswKrYVbzXqIqZGJL-DpBVheTJc2smMEYkHG-55r-gscp6N4N3m0AnX-NT29qrcroh_LloQdgGhTtyO0A2doLs02kPn9g5UQvtbEwXU6yRuXfH5i6Q_j95qlqqf3DD0YtS-VoXbCZ6hiERPOFfpgP9mL')\"></div>\n</div>\n<!-- Two Column Split inside Left Col -->\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-lg\">\n<!-- Frequent Issues -->\n<div class=\"glass-panel rounded-xl p-lg flex flex-col border border-outline-variant/30 shadow-sm\">\n<h3 class=\"font-h3 text-h3 font-semibold text-on-surface mb-md\">Most Frequent Issues</h3>\n<div class=\"w-full h-[220px] bg-cover bg-center rounde