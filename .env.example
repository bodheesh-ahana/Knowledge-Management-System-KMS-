# Environment Variables

# =====================================
# DATABASE & STORAGE CONFIGURATION
# =====================================

# MongoDB - All structured data
# Create free cluster: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kms?retryWrites=true&w=majority

# Local File Storage (for images and documents)
# Files stored in: public/uploads/
# Later migrate to Cloudinary, AWS S3, or similar
# For now: Set to 'local' to store files locally
STORAGE_TYPE=local
# Maximum file size: 5MB (5242880 bytes)
MAX_UPLOAD_SIZE=5242880
# Allowed image types: image/jpeg, image/png, image/gif, image/webp
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# =====================================
# AUTHENTICATION
# =====================================

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Optional: Microsoft Entra ID OAuth
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =====================================
# EMAIL (Optional - for future notifications)
# =====================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kms.example.com

# =====================================
# APPLICATION SETTINGS
# =====================================

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Knowledge Management System
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# =====================================
# MONITORING & LOGGING (Optional)
# =====================================

NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# =====================================
# NOTES
# =====================================
# 
# STORAGE STRATEGY:
# 1. MongoDB - All data (users, articles, tickets, etc.)
# 2. Local Filesystem (public/uploads/) - Images, documents
# 3. Browser LocalStorage - UI state, drafts, preferences
#
# DATA RETENTION:
# - SearchHistory: 30 days (TTL index in MongoDB)
# - Notifications: 30 days (TTL index in MongoDB)
# - AuditLogs: Permanent (for compliance)
# - User Data: Until deleted
#
# FUTURE MIGRATION:
# To migrate to Cloudinary or S3:
# 1. Update STORAGE_TYPE to 'cloudinary' or 's3'
# 2. Add provider API keys
# 3. Files will auto-upload to cloud (no MongoDB schema changes needed)
#

